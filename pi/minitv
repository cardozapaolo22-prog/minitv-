def _limpiar_terminal(b):
    """Quita los colores y marcas de readline que escribe bluetoothctl."""
    t = b.decode("utf-8", "replace")
    return re.sub(r"\x1b\[[0-9;?]*[A-Za-z]|[\x01\x02]", "", t).strip()


class Bluetooth:
    """Mientras se está en Ajustes → Bluetooth hay una sesión de bluetoothctl abierta con un agente
    (el que muestra el código para escribir en un teclado y acepta los demás pedidos). Las operaciones
    lentas (emparejar, conectar, consultar) las hace un hilo aparte para no trabar el menú.
    El menú solo lee: encontrados, guardados, codigo, ocupado y mensaje."""

    TIPOS = (("input-keyboard", "Teclado"), ("input-gaming", "Mando"), ("input-mouse", "Mouse"),
             ("audio-card", "Parlante"), ("audio-headset", "Audífonos"), ("audio-headphones", "Audífonos"),
             ("phone", "Teléfono"), ("computer", "Computador"), ("video-display", "TV"),
             ("input-tablet", "Tableta"))
    MAC = r"([0-9A-F]{2}(?::[0-9A-F]{2}){5})"

    def __init__(self):
        self.proc = None
        self.lock = threading.Lock()
        self.encontrados = {}          # mac -> {"nombre", "tipo", "rssi", "emparejado"}
        self.guardados = []            # [{"mac", "nombre", "tipo", "conectado"}]
        self.buscando = False
        self.codigo = None             # código a escribir en el dispositivo (se muestra grande)
        self.ocupado = None            # "Emparejando…", "Conectando…"...
        self.mensaje = None            # (texto, hasta)
        self.visible_hasta = 0         # Música → Conectar un teléfono: la TV visible como "Mini TV"
        self.eventos = queue.Queue()
        self.trabajos = queue.Queue()
        threading.Thread(target=self._trabajador, daemon=True).start()

    # ----- sesión interactiva (agente + búsqueda) -----
    def _abrir(self):
        if self.proc and self.proc.poll() is None:
            return
        self.proc = subprocess.Popen(["bluetoothctl"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=subprocess.STDOUT, bufsize=0)
        threading.Thread(target=self._leer, args=(self.proc,), daemon=True).start()
        self._orden("agent KeyboardDisplay")
        self._orden("default-agent")

    def _orden(self, texto):
        try:
            self.proc.stdin.write((texto + "\n").encode())
            self.proc.stdin.flush()
        except (OSError, AttributeError, ValueError):
            pass

    def cerrar_sesion(self):
        self.dejar_de_buscar()
        if self.proc and self.proc.poll() is None:
            self._orden("quit")
            try:
                self.proc.wait(2)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self.proc = None

    def _leer(self, proc):
        resto = b""
        fd = proc.stdout.fileno()
        while True:
            try:
                trozo = os.read(fd, 4096)
            except OSError:
                break
            if not trozo:
                break
            partes = re.split(rb"[\r\n]", resto + trozo)
            resto = partes.pop()
            for p in partes:
                self._linea(_limpiar_terminal(p))
            pendiente = _limpiar_terminal(resto)        # las preguntas del agente no terminan en \n
            if re.search(r"\(yes/no\)|Enter PIN code|Enter passkey", pendiente):
                self._linea(pendiente)
                resto = b""

    def _linea(self, l):
        if not l:
            return
        m = re.search(r"\[NEW\] Device " + self.MAC + r" (.*)", l)
        if m:
            self._visto(m.group(1), m.group(2))
            return
        m = re.search(r"\[CHG\] Device " + self.MAC + r" (Name|Alias|RSSI): (.*)", l)
        if m:
            mac, campo, valor = m.groups()
            if campo == "RSSI":
                with self.lock:
                    if mac in self.encontrados:
                        n = re.search(r"\((-?\d+)\)|^(-?\d+)$", valor.strip())   # "-64" o "0xffffffc0 (-64)"
                        if n:
                            self.encontrados[mac]["rssi"] = int(n.group(1) or n.group(2))
            else:
                self._visto(mac, valor)
            return
        m = re.search(r"Passkey: (\d+)", l) or re.search(r"PIN code: (\w+)", l)
        if m and "Enter" not in l:
            self.codigo = m.group(1).zfill(6) if m.group(1).isdigit() and "Passkey" in l else m.group(1)
            log(f"Bluetooth: código {self.codigo}")
            return
        m = re.search(r"Confirm passkey (\d+)", l)
        if m:                                           # teléfono: el mismo código sale en su pantalla
            self.codigo = m.group(1).zfill(6)
            self._orden("yes")
            return
        if re.search(r"Authorize service|Request authorization|Accept pairing", l):
            self._orden("yes")                          # mandos y parlantes: aceptar
            return
        m = re.search(r"\[CHG\] Device " + self.MAC + r" Paired: yes", l)
        if m and self.visible():                        # un teléfono se emparejó: de confianza (se reconecta solo)
            self._orden(f"trust {m.group(1)}")
            self.codigo = None
            self._avisar("Teléfono emparejado", "Ya puedes poner música en él")
            return
        if "Enter PIN code" in l:
            self._orden("0000")                         # dispositivos antiguos con PIN fijo
            return
        if "Enter passkey" in l:
            self._orden("0")
            return
        for frase in ("Pairing successful", "AlreadyExists", "Failed to pair", "Connection successful",
                      "Failed to connect", "not available"):
            if frase in l:                              # solo la primera ("Failed to pair: ...AlreadyExists")
                self.eventos.put(frase)
                break

    def _visto(self, mac, nombre):
        con_nombre = nombre and not re.fullmatch(r"[0-9A-F]{2}(?:-[0-9A-F]{2}){5}", nombre)
        nuevo = False
        with self.lock:
            if not self.buscando:
                return
            d = self.encontrados.get(mac)
            if d is None:
                d = self.encontrados[mac] = {"nombre": None, "tipo": None, "rssi": -999, "emparejado": False,
                                             "consultado": False}
            if con_nombre:
                d["nombre"] = nombre
                if not d["consultado"]:
                    d["consultado"] = nuevo = True
        if nuevo:
            self.trabajos.put(lambda: self._completar(mac))

    def _completar(self, mac):
        info = self.info(mac)
        with self.lock:
            d = self.encontrados.get(mac)
            if d:
                d["tipo"] = info["tipo"]
                d["emparejado"] = info["emparejado"]
                d["nombre"] = info["nombre"] or d["nombre"]

    # ----- consultas sueltas -----
    @classmethod
    def tipo_de(cls, icono):
        return next((t for i, t in cls.TIPOS if icono.startswith(i)), "Dispositivo")

    def info(self, mac):
        try:
            out = subprocess.run(["bluetoothctl", "info", mac], capture_output=True, timeout=5).stdout
        except (OSError, subprocess.TimeoutExpired):
            out = b""
        campos = dict(re.findall(r"^\s*(\w+): (.*)$", _limpiar_terminal(out), re.M))
        return {"mac": mac, "nombre": campos.get("Alias") or campos.get("Name"),
                "tipo": self.tipo_de(campos.get("Icon", "")), "emparejado": campos.get("Paired") == "yes",
                "conectado": campos.get("Connected") == "yes"}

    def _ejecutar(self, *args, espera=25):
        try:
            r = subprocess.run(["bluetoothctl", *args], capture_output=True, timeout=espera)
            return _limpiar_terminal(r.stdout)
        except (OSError, subprocess.TimeoutExpired):
            return ""

    # ----- lo que pide el menú -----
    def buscar(self):
        with self.lock:
            self.encontrados, self.buscando = {}, True
        self._abrir()
        self._orden("scan on")
        log("Bluetooth: buscando")

    def hacer_visible(self, segundos=180):
        """Para emparejar un teléfono: la TV aparece como "Mini TV" en su lista de Bluetooth."""
        self._abrir()
        self._orden("pairable on")
        self._orden(f"discoverable-timeout {segundos}")
        self._orden("discoverable on")
        self.visible_hasta = ahora() + segundos
        self.codigo = None
        log(f"Bluetooth: visible {segundos} s para emparejar un teléfono")

    def visible(self):
        return self.visible_hasta > ahora()

    def revisar(self, en_menu_bluetooth):
        """Al acabar el tiempo visible: dejar de ser visible y cerrar la sesión si no se usa."""
        if self.visible_hasta and not self.visible():
            self.visible_hasta = 0
            self.codigo = None
            self._orden("discoverable off")
            if not en_menu_bluetooth:
                self.cerrar_sesion()

    def dejar_de_buscar(self):
        if self.buscando:
            self.buscando = False
            self._orden("scan off")

    def lista_encontrados(self):
        """Dispositivos con nombre y aún no emparejados; primero los de tipo conocido, luego por señal."""
        with self.lock:
            ds = [dict(d, mac=m) for m, d in self.encontrados.items() if d["nombre"] and not d["emparejado"]]
        return sorted(ds, key=lambda d: (d["tipo"] in (None, "Dispositivo"), -d["rssi"]))

    def actualizar_guardados(self):
        def tarea():
            out = self._ejecutar("paired-devices", espera=5)
            macs = re.findall(r"Device " + self.MAC, out)
            self.guardados = [self.info(m) for m in macs]
        self.trabajos.put(tarea)

    def _avisar(self, texto, detalle=None, segundos=3):
        self.mensaje = (texto, ahora() + segundos, detalle)
        log(f"Bluetooth: {texto}" + (f" ({detalle})" if detalle else ""))

    def emparejar(self, mac, nombre):
        def tarea():
            self.dejar_de_buscar()
            self._abrir()
            while not self.eventos.empty():
                self.eventos.get_nowait()
            self.codigo, self.ocupado = None, f"Emparejando con {nombre}…"
            self._orden(f"pair {mac}")
            r = self._esperar(("Pairing successful", "AlreadyExists", "Failed to pair", "not available"), 60)
            self.codigo = None
            if r not in ("Pairing successful", "AlreadyExists"):
                self.ocupado = None
                self._avisar("No se pudo conectar")
                return
            self.ocupado = f"Conectando con {nombre}…"
            self._orden(f"trust {mac}")
            time.sleep(0.5)
            self._orden(f"connect {mac}")
            self._esperar(("Connection successful", "Failed to connect"), 20)
            ok = self.info(mac)["conectado"]
            self.ocupado = None
            if ok and "Joy-Con" in (nombre or ""):
                # joycond los deja parpadeando hasta elegir cómo se usan
                self._avisar("Conectado", "Dos juntos: pulsa L + R a la vez. Uno de lado: SL + SR", 8)
            else:
                self._avisar("Conectado" if ok else "No se pudo conectar")
            with self.lock:
                self.encontrados.pop(mac, None)
            self.actualizar_guardados()
        self.trabajos.put(tarea)

    def _esperar(self, frases, segundos):
        limite = ahora() + segundos
        while ahora() < limite:
            try:
                e = self.eventos.get(timeout=0.5)
            except queue.Empty:
                continue
            if e in frases:
                return e
        return None

    def accion(self, mac, nombre, que):
        """que: 'conectar', 'desconectar' u 'olvidar'."""
        def tarea():
            if que == "conectar":
                self.ocupado = f"Conectando con {nombre}…"
                self._ejecutar("connect", mac)
                self._avisar("Conectado" if self.info(mac)["conectado"] else "No se pudo conectar")
            elif que == "desconectar":
                self.ocupado = f"Desconectando {nombre}…"
                self._ejecutar("disconnect", mac)
                self._avisar("Desconectado")
            else:
                self.ocupado = f"Olvidando {nombre}…"
                self._ejecutar("remove", mac)
                self._avisar("Olvidado")
            self.ocupado = None
            self.actualizar_guardados()
        self.trabajos.put(tarea)

    def _trabajador(self):
        while True:
            tarea = self.trabajos.get()
            try:
                tarea()
            except Exception as e:                      # que un fallo no deje el menú "ocupado"
                log(f"Bluetooth: error {e!r}")
                self.ocupado, self.codigo = None, None
                self._avisar("No se pudo conectar")


