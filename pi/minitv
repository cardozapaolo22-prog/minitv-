class Spotify:
    """Lee lo que deja minitv-spotify-evento (lo ejecuta librespot) en /run/raspotify:
    pista.txt (canción), reproduccion.txt (loading/playing/paused/stopped + posición) y volumen.txt.
    La carátula se descarga en un hilo aparte. No guarda nada de la cuenta."""

    TAM_CARATULA = 112

    def __init__(self):
        self.fechas = {}
        self.pista = {}
        self.estado, self.pos_ms, self.at_ms = None, 0, 0
        self.volumen = None
        self.caratula = None            # (track_id, Image RGB TAM x TAM)
        self.bajando = None

    @staticmethod
    def _leer(nombre):
        try:
            with open(os.path.join(SPOTIFY_DIR, nombre), encoding="utf-8", errors="replace") as f:
                return dict(l.rstrip("\n").split("\t", 1) for l in f if "\t" in l)
        except OSError:
            return None

    def _cambio(self, nombre):
        try:
            fecha = os.path.getmtime(os.path.join(SPOTIFY_DIR, nombre))
        except OSError:
            fecha = None
        if fecha != self.fechas.get(nombre):
            self.fechas[nombre] = fecha
            return True
        return False

    def poll(self):
        """Devuelve el conjunto de cosas que cambiaron: 'pista', 'estado', 'volumen'."""
        cambios = set()
        if self._cambio("pista.txt"):
            self.pista = self._leer("pista.txt") or {}
            cambios.add("pista")
            self._pedir_caratula()
        if self._cambio("reproduccion.txt"):
            r = self._leer("reproduccion.txt")
            if r is None:                                   # raspotify se reinició: no hay sesión
                self.estado, self.pos_ms = None, 0
            else:
                self.estado = r.get("STATE")
                self.pos_ms = int(r.get("POSITION_MS", "0") or 0)
                self.at_ms = int(r.get("AT_MS", "0") or 0)
            cambios.add("estado")
        if self._cambio("volumen.txt"):
            v = self._leer("volumen.txt")
            if v and v.get("VOLUME", "").isdigit():
                self.volumen = int(v["VOLUME"])
                cambios.add("volumen")
        return cambios

    origen = "Spotify · Mini TV"

    def activo(self):
        return self.estado in ("loading", "playing", "paused")

    def sonando(self):
        return self.estado in ("loading", "playing")

    @property
    def nombre(self):
        return self.pista.get("NAME", "")

    @property
    def artistas(self):
        return ", ".join(a for a in self.pista.get("ARTISTS", "").split("|") if a)

    @property
    def album(self):
        return self.pista.get("ALBUM", "")

    @property
    def duracion_ms(self):
        d = self.pista.get("DURATION_MS", "0")
        return int(d) if d.isdigit() else 0

    def posicion_ms(self):
        p = self.pos_ms
        if self.estado == "playing" and self.at_ms:
            p += max(0, int(time.time() * 1000) - self.at_ms)
        return min(p, self.duracion_ms) if self.duracion_ms else p

    def _pedir_caratula(self):
        tid = self.pista.get("TRACK_ID")
        urls = [u for u in self.pista.get("COVERS", "").split("|") if u.startswith("http")]
        if not urls or (self.caratula and self.caratula[0] == tid) or self.bajando == tid:
            return
        url = urls[1] if len(urls) >= 3 else urls[0]          # la mediana (~300 px) si hay varias
        self.bajando = tid

        def bajar():
            try:
                import io
                import urllib.request
                with urllib.request.urlopen(url, timeout=8) as r:
                    img = Image.open(io.BytesIO(r.read())).convert("RGB")
                img = img.resize((self.TAM_CARATULA, self.TAM_CARATULA), Image.LANCZOS)
                self.caratula = (tid, img)
            except Exception as e:
                log(f"Spotify: no se pudo bajar la carátula ({e!r})")
            finally:
                self.bajando = None
        threading.Thread(target=bajar, daemon=True).start()

    def imagen_caratula(self):
        if self.caratula and self.caratula[0] == self.pista.get("TRACK_ID"):
            return self.caratula[1]
        return None

    def cortar(self):
        """Corta la música (la sesión de Spotify termina) y libera el audio para la TV."""
        log("Spotify: cortar la música")
        subprocess.run(["sudo", "-n", "systemctl", "restart", "raspotify"], timeout=15)
        self.estado, self.pos_ms = None, 0


class TelefonoBT:
    """Un teléfono conectado por Bluetooth que manda música a la TV ("Mini TV", parlante A2DP con
    bluez-alsa). Un hilo consulta a BlueZ por D-Bus cada segundo: transporte de audio (si suena y su
    volumen) y el reproductor AVRCP (canción, artista, álbum, duración, posición). Misma interfaz que
    Spotify para la pantalla "Ahora suena". El audio lo reproduce bluealsa-aplay, que solo se arranca
    después de detener VLC (la tarjeta de sonido no se comparte)."""

    def __init__(self):
        self.estado = None              # "playing", "paused" o None (sin teléfono sonando)
        self.pista = {}
        self.pos_ms, self.at_ms = 0, 0
        self.volumen = None             # 0..65535 (como Spotify), desde el volumen del teléfono
        self.dispositivo = ""
        self.jugador = None             # ruta D-Bus del reproductor AVRCP (para pausar)
        self.aplay = None
        self._ultimo = None
        self._bloqueo = threading.Lock()
        threading.Thread(target=self._vigilar, daemon=True).start()

    def _vigilar(self):
        bus = None
        while True:
            try:
                import dbus
                if bus is None:
                    bus = dbus.SystemBus()
                om = dbus.Interface(bus.get_object("org.bluez", "/"), "org.freedesktop.DBus.ObjectManager")
                objs = om.GetManagedObjects()
                # Un teléfono emparejado que manda audio y no es "de confianza": BlueZ le niega el
                # canal de audio (a2dp auth_cb: Access denied). Marcarlo de confianza aquí mismo.
                for ruta, ifs in objs.items():
                    dev = ifs.get("org.bluez.Device1")
                    if dev and dev.get("Paired") and not dev.get("Trusted") and \
                            "0000110a-0000-1000-8000-00805f9b34fb" in [str(u) for u in dev.get("UUIDs", [])]:
                        dbus.Interface(bus.get_object("org.bluez", ruta), "org.freedesktop.DBus.Properties") \
                            .Set("org.bluez.Device1", "Trusted", dbus.Boolean(True))
                        log(f"Teléfono BT: {dev.get('Alias', ruta)} marcado de confianza")
                transportes = [(str(p), i["org.bluez.MediaTransport1"]) for p, i in objs.items()
                               if "org.bluez.MediaTransport1" in i]
                jugadores = [(str(p), i["org.bluez.MediaPlayer1"]) for p, i in objs.items()
                             if "org.bluez.MediaPlayer1" in i]
                estado, pista, pos, vol, disp, jugador = None, {}, 0, None, "", None
                if transportes:
                    ruta_t, t = transportes[0]
                    if "Volume" in t:
                        vol = int(int(t["Volume"]) * 65535 / 127)
                    dev = str(t.get("Device", ""))
                    disp = str(objs.get(dev, {}).get("org.bluez.Device1", {}).get("Alias", ""))
                    jug = next(((p, j) for p, j in jugadores if p.startswith(dev)), None)
                    status = str(jug[1].get("Status", "")) if jug else ""
                    if jug:
                        jugador = jug[0]
                        tr = jug[1].get("Track", {})
                        pista = {"NAME": str(tr.get("Title", "")), "ARTISTS": str(tr.get("Artist", "")),
                                 "ALBUM": str(tr.get("Album", "")), "DURATION_MS": str(int(tr.get("Duration", 0)))}
                        pos = int(jug[1].get("Position", 0))
                    if status == "playing" or str(t.get("State", "")) in ("active", "pending"):
                        estado = "playing"
                    elif status == "paused":
                        estado = "paused"
                with self._bloqueo:
                    if pos != self.pos_ms or estado != self.estado:
                        self.pos_ms, self.at_ms = pos, int(time.time() * 1000)
                    self.estado, self.pista, self.volumen = estado, pista, vol
                    self.dispositivo, self.jugador = disp, jugador
            except Exception as e:
                if bus is not None:
                    log(f"Teléfono BT: {e!r}")
                bus = None
                time.sleep(2)
            time.sleep(1)

    def poll(self):
        with self._bloqueo:
            ahora_ = (self.estado, self.pista.get("NAME"), self.volumen)
        antes, self._ultimo = self._ultimo, ahora_
        cambios = set()
        if antes is None or antes[0] != ahora_[0]:
            cambios.add("estado")
        if antes is None or antes[1] != ahora_[1]:
            cambios.add("pista")
        if ahora_[2] is not None and (antes is None or antes[2] != ahora_[2]):
            cambios.add("volumen")
        return cambios

    def activo(self):
        # En pausa solo cuenta mientras la TV está reproduciendo su audio (si no, una pausa en el
        # teléfono bloquearía la TV para siempre)
        sonando_aqui = self.aplay is not None and self.aplay.poll() is None
        return self.estado == "playing" or (self.estado == "paused" and sonando_aqui)

    def sonando(self):
        return self.estado == "playing"

    origen = property(lambda self: f"Bluetooth · {self.dispositivo or 'teléfono'}")
    nombre = property(lambda self: self.pista.get("NAME", "") or "Música por Bluetooth")
    artistas = property(lambda self: self.pista.get("ARTISTS", ""))
    album = property(lambda self: self.pista.get("ALBUM", ""))

    @property
    def duracion_ms(self):
        d = self.pista.get("DURATION_MS", "0")
        return int(d) if d.isdigit() else 0

    def posicion_ms(self):
        p = self.pos_ms
        if self.estado == "playing" and self.at_ms:
            p += max(0, int(time.time() * 1000) - self.at_ms)
        return min(p, self.duracion_ms) if self.duracion_ms else p

    def imagen_caratula(self):
        return None                     # AVRCP de BlueZ 5.55 no trae la carátula

    def iniciar_audio(self):
        if self.aplay is None or self.aplay.poll() is not None:
            self.aplay = subprocess.Popen(["bluealsa-aplay", "-S", f"--pcm={BT_AUDIO}"],
                                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            log("Teléfono BT: audio a la TV")

    def detener_audio(self):
        if self.aplay and self.aplay.poll() is None:
            self.aplay.terminate()
            try:
                self.aplay.wait(2)
            except subprocess.TimeoutExpired:
                self.aplay.kill()
        self.aplay = None

    def cortar(self):
        """Pausar el teléfono y liberar el audio para la TV."""
        try:
            import dbus
            if self.jugador:
                dbus.Interface(dbus.SystemBus().get_object("org.bluez", self.jugador),
                               "org.bluez.MediaPlayer1").Pause()
        except Exception as e:
            log(f"Teléfono BT: no se pudo pausar ({e!r})")
        self.detener_audio()
        with self._bloqueo:
            self.estado = "paused" if self.estado else None


class LectorMandos(threading.Thread):
    """Mandos (Joy-Con, Mando Pro, cualquier gamepad) y teclados por evdev, para manejar el menú.
    Convierte en las mismas órdenes que los botones: arriba/abajo (cruceta, stick o flechas),
    elegir (A, +, −, Enter) y menu = volver (B, Home, Captura, Esc, Retroceso).
    Detecta los que se conectan o desconectan (Bluetooth) cada 2 s. Mientras hay un juego abierto
    no hace nada: los controles son de RetroArch."""

    REPETIR_TRAS, REPETIR_CADA = 0.45, 0.13      # mantener una dirección: repetir

    def __init__(self, cola, activo):
        super().__init__(daemon=True)
        import evdev
        self.evdev, self.cola, self.activo = evdev, cola, activo
        e = evdev.ecodes
        # Un Joy-Con suelto tiene pocos botones: que todos hagan algo (gatillos y SL/SR también mueven)
        self.ELEGIR = {e.BTN_EAST, e.BTN_NORTH, e.BTN_START, e.BTN_SELECT, e.BTN_THUMBL, e.BTN_THUMBR,
                       e.KEY_ENTER, e.KEY_KPENTER}
        self.VOLVER = {e.BTN_SOUTH, e.BTN_WEST, e.BTN_MODE, e.BTN_Z, e.KEY_ESC, e.KEY_BACKSPACE}
        self.ARRIBA = {e.BTN_DPAD_UP, e.BTN_DPAD_LEFT, e.BTN_TL, e.BTN_TL2, e.KEY_UP, e.KEY_LEFT}
        self.ABAJO = {e.BTN_DPAD_DOWN, e.BTN_DPAD_RIGHT, e.BTN_TR, e.BTN_TR2, e.KEY_DOWN, e.KEY_RIGHT}
        self.disp = {}          # fd -> InputDevice
        self.ejes = {}          # (fd, código) -> (centro, umbral)
        self.valores = {}       # (fd, código) -> último valor del eje (para elegir el eje dominante)
        self.direccion = {}     # (fd, origen) -> "arriba"/"abajo"/None (origen: hat o stick)
        self.mantenida = None   # (orden, desde, última repetición)
        self.t_buscar = 0

    def _sirve(self, d):
        if "IMU" in d.name:                      # sensores de movimiento de los Joy-Con
            return False
        caps = d.capabilities()
        teclas = set(caps.get(self.evdev.ecodes.EV_KEY, []))
        e = self.evdev.ecodes
        return bool(teclas & {e.BTN_SOUTH, e.BTN_EAST, e.BTN_DPAD_UP, e.BTN_START}) or \
            {e.KEY_ENTER, e.KEY_UP} <= teclas

    def _buscar(self):
        rutas = {d.path for d in self.disp.values()}
        for ruta in self.evdev.list_devices():
            if ruta in rutas:
                continue
            try:
                d = self.evdev.InputDevice(ruta)
            except OSError:
                continue
            if not self._sirve(d):
                d.close()
                continue
            self.disp[d.fd] = d
            for codigo, info in d.capabilities(absinfo=True).get(self.evdev.ecodes.EV_ABS, []):
                centro = (info.max + info.min) / 2
                self.ejes[(d.fd, codigo)] = (centro, (info.max - info.min) / 4)
            log(f"Mando/teclado para el menú: {d.name}")

    def _quitar(self, fd):
        d = self.disp.pop(fd, None)
        if d:
            log(f"Desconectado: {d.name}")
            try:
                d.close()
            except OSError:
                pass

    def _orden(self, orden, origen):
        self.cola.put((orden, origen))

    def _direccion(self, fd, origen, nueva, nombre):
        clave = (fd, origen)
        if self.direccion.get(clave) == nueva:
            return
        self.direccion[clave] = nueva
        if nueva:
            self._orden(nueva, nombre)
            self.mantenida = (nueva, ahora(), ahora(), nombre)
        elif self.mantenida and self.mantenida[0]:
            self.mantenida = None

    def _evento(self, d, ev):
        e = self.evdev.ecodes
        if ev.type == e.EV_KEY:
            if ev.value == 1:                    # pulsar (2 = repetición del teclado: ignorar)
                if ev.code in self.ELEGIR:
                    self._orden("elegir", d.name)
                elif ev.code in self.VOLVER:
                    self._orden("menu", d.name)
                elif ev.code in self.ARRIBA or ev.code in self.ABAJO:
                    orden = "arriba" if ev.code in self.ARRIBA else "abajo"
                    self._orden(orden, d.name)
                    self.mantenida = (orden, ahora(), ahora(), d.name)
            elif ev.value == 0 and (ev.code in self.ARRIBA or ev.code in self.ABAJO):
                self.mantenida = None
        elif ev.type == e.EV_ABS:
            if ev.code in (e.ABS_HAT0X, e.ABS_HAT0Y):
                nueva = "arriba" if ev.value < 0 else "abajo" if ev.value > 0 else None
                self._direccion(d.fd, f"hat{ev.code}", nueva, d.name)
            elif ev.code in (e.ABS_X, e.ABS_Y, e.ABS_RX, e.ABS_RY):   # cualquier stick (el Joy-Con derecho solo tiene RX/RY)
                # Con el Joy-Con de lado los dos ejes se mueven a la vez: cuenta solo el que más se movió
                par = (e.ABS_X, e.ABS_Y) if ev.code in (e.ABS_X, e.ABS_Y) else (e.ABS_RX, e.ABS_RY)
                self.valores[(d.fd, ev.code)] = ev.value
                mejor, nueva = 0.0, None
                for codigo in par:
                    centro, umbral = self.ejes.get((d.fd, codigo), (0, 1 << 30))
                    v = self.valores.get((d.fd, codigo), centro) - centro
                    if abs(v) > umbral and abs(v) / umbral > mejor:
                        mejor, nueva = abs(v) / umbral, ("arriba" if v < 0 else "abajo")
                self._direccion(d.fd, f"stick{par[0]}", nueva, d.name)

    def run(self):
        import select
        while True:
            t = ahora()
            if t - self.t_buscar > 2:
                self.t_buscar = t
                try:
                    self._buscar()
                except Exception as ex:          # nunca dejar el menú sin botones por un mando raro
                    log(f"Mandos: {ex!r}")
            try:
                listos, _, _ = select.select(list(self.disp), [], [], 0.05)
            except (OSError, ValueError):
                listos = []
                for fd in list(self.disp):
                    try:
                        os.fstat(fd)
                    except OSError:
                        self._quitar(fd)
            for fd in listos:
                d = self.disp.get(fd)
                try:
                    eventos = list(d.read())
                except OSError:
                    self._quitar(fd)
                    continue
                if self.activo():
                    for ev in eventos:
                        self._evento(d, ev)
            if self.mantenida and self.activo():
                orden, desde, ultima, nombre = self.mantenida
                if ahora() - desde > self.REPETIR_TRAS and ahora() - ultima > self.REPETIR_CADA:
                    self._orden(orden, nombre)
                    self.mantenida = (orden, desde, ahora(), nombre)
            elif not self.activo():
                self.mantenida = None


class LectorBotones(threading.Thread):
    """Convierte pulsaciones en órdenes (las mismas que minitv-control) y las deja en una cola.
    Corta = al soltar antes del tiempo de 'mantenido'. Mantenido = en cuanto se cumple el tiempo
    (sin esperar a soltar); el soltar posterior se ignora. Antirrebote: 8 lecturas iguales (40 ms)."""

    PERIODO = 0.005
    ESTABLE = 8

    def __init__(self, botones, cola):
        """botones: lista de (gpio, orden_corta, orden_mantenida, segundos_mantenido)."""
        super().__init__(daemon=True)
        import RPi.GPIO as GPIO
        self.GPIO = GPIO
        GPIO.setwarnings(False)
        GPIO.setmode(GPIO.BCM)
        self.botones = []
        for gpio, corta, mantenida, t_mantenido in botones:
            GPIO.setup(gpio, GPIO.IN, pull_up_down=GPIO.PUD_UP)
            self.botones.append({"gpio": gpio, "corta": corta, "mantenida": mantenida, "t": t_mantenido,
                                 "pulsado": False, "desde": 0.0, "mantenida_enviada": False, "iguales": 0})
        self.cola = cola

    def run(self):
        while True:
            t = ahora()
            for b in self.botones:
                abajo = self.GPIO.input(b["gpio"]) == 0
                if abajo != b["pulsado"]:
                    b["iguales"] += 1
                    if b["iguales"] >= self.ESTABLE:          # cambio confirmado (antirrebote)
                        b["iguales"] = 0
                        b["pulsado"] = abajo
                        if abajo:
                            b["desde"], b["mantenida_enviada"] = t, False
                        elif not b["mantenida_enviada"]:
                            self.cola.put((b["corta"], f"botón GPIO{b['gpio']} corto"))
                else:
                    b["iguales"] = 0
                    if abajo and not b["mantenida_enviada"] and t - b["desde"] >= b["t"]:
                        b["mantenida_enviada"] = True
                        self.cola.put((b["mantenida"], f"botón GPIO{b['gpio']} mantenido {b['t']:g} s"))
            time.sleep(self.PERIODO)


