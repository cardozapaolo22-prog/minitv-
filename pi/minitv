# VLC con su interfaz de control rc (para saber episodio, segundo y si ya hay imagen)
# =============================================================================================


class VLC:
    def __init__(self, items, audio=True, rotulo=None, volumen=100, bucle=False):
        """items: lista de (ruta, segundo_inicial)."""
        args = ["cvlc", "--intf", "dummy", "--extraintf", "oldrc", "--rc-unix", SOCK_VLC, "--rc-fake-tty",
                "--fullscreen", "--no-osd", "--no-video-title-show",
                "--vout", "mmal_vout", "--no-mmal-adjust-refreshrate", "--codec", "mmal,any"]
        if audio and AUDIO:
            args += ["--aout", "alsa", "--alsa-audio-device", AUDIO_DEVICE, "--gain", str(AUDIO_GAIN)]
        else:
            args += ["--no-audio"]
        if rotulo:
            args += ["--sub-source", "marq", "--marq-marquee", rotulo, "--marq-position", "6",
                     "--marq-x", "6", "--marq-y", "5", "--marq-size", "13", "--marq-timeout", "6000",
                     "--marq-color", "0xFFFFFF", "--marq-opacity", "235",
                     "--freetype-font", "DejaVu Sans", "--freetype-outline-thickness", "2"]
        args += ["--loop"] if bucle else ["--play-and-exit"]
        for ruta, segundo in items:
            args.append(ruta)
            if segundo:
                args.append(f":start-time={int(segundo)}")
        try:
            os.unlink(SOCK_VLC)
        except OSError:
            pass
        self.proc = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL)
        self.t_inicio = ahora()
        self.sock = None
        self.buf = b""
        self.eventos = []
        self.volumen = volumen
        self.volumen_aplicado = False

    def vivo(self):
        return self.proc.poll() is None

    def conectar(self):
        if self.sock:
            return True
        try:
            s = socket.socket(socket.AF_UNIX)
            s.connect(SOCK_VLC)
            s.setblocking(False)
            self.sock = s
        except OSError:
            return False
        return True

    def _leer(self, espera=0.0):
        """Lee lo disponible (hasta 'espera' s). Recoge los avisos de 'new input'."""
        limite = ahora() + espera
        while True:
            try:
                trozo = self.sock.recv(8192)
                if not trozo:
                    raise ConnectionError
                self.buf += trozo
            except BlockingIOError:
                if ahora() >= limite:
                    break
                time.sleep(0.01)
        fin = 0
        for m in re.finditer(rb"new input: (\S+) \)", self.buf):
            ruta = urllib.parse.unquote(m.group(1).decode("utf-8", "replace").replace("file://", ""))
            self.eventos.append(os.path.basename(ruta))
            fin = m.end()
        if fin:
            self.buf = self.buf[fin:]               # no volver a contar los mismos avisos

    def consulta(self, orden, patron, espera=0.3):
        """Envía una orden y devuelve el primer grupo de 'patron' en la respuesta (o None)."""
        if not self.conectar():
            return None
        try:
            self._leer()
            self.buf = b""
            self.sock.sendall(orden.encode() + b"\n")
            limite = ahora() + espera
            while ahora() < limite:
                self._leer(0.02)
                m = re.search(patron, self.buf, re.M)
                if m:
                    return m.group(1)
        except (OSError, ConnectionError):
            self.sock = None
        return None

    def cuadros_mostrados(self):
        r = self.consulta("stats", rb"frames displayed\s*:\s*(\d+)")
        return int(r) if r is not None else None

    def segundo(self):
        r = self.consulta("get_time", rb"^\s*(\d+)\s*$")
        return int(r) if r is not None else None

    def poner_volumen(self, porcentaje):
        self.volumen = porcentaje
        if self.conectar():
            try:
                self.sock.sendall(f"volume {round(porcentaje * 2.56)}\n".encode())
                self.volumen_aplicado = True
            except OSError:
                self.sock = None

    def pausa(self):
        """Pausa / sigue (la orden "pause" de VLC alterna)."""
        if self.conectar():
            try:
                self.sock.sendall(b"pause\n")
                self.en_pausa = not getattr(self, "en_pausa", False)
            except OSError:
                self.sock = None

    def nuevos_episodios(self):
        if self.sock:
            try:
                self._leer()
            except (OSError, ConnectionError):
                self.sock = None
        ev, self.eventos = self.eventos, []
        self.buf = self.buf[-4096:]
        return ev

    def cerrar(self):
        if self.vivo():
            self.proc.terminate()
            try:
                self.proc.wait(2)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        if self.sock:
            self.sock.close()


class Reproduccion:
    """Una serie en pantalla: continúa donde se quedó y avanza en orden por los episodios."""

    def __init__(self, serie, estado, estatica, inicio=None):
        """inicio: (índice de episodio, segundo); por defecto, donde se quedó la serie."""
        self.serie, self.estado, self.estatica = serie, estado, estatica
        i, seg = inicio if inicio is not None else estado.seguir(serie)
        eps = serie.episodios
        orden = eps[i:] + eps[:i]
        items = [(os.path.join(serie.carpeta, e), seg if k == 0 else 0) for k, e in enumerate(orden)]
        # Toda la serie, empezando por el episodio guardado, en bucle
        self.vlc = VLC(items, rotulo=serie.rotulo, volumen=estado.datos.get("volumen", 100), bucle=True)
        self.episodio, self.seg = eps[i], seg
        self.primer_aviso = True
        self.esperando_imagen = True
        self.t_consulta = self.t_guardado = ahora()
        estado.recordar(serie, self.episodio, self.seg)
        log(f"Ver {serie.rotulo}: {self.episodio} desde el segundo {seg}")

    def tick(self):
        """Devuelve 'fin' si VLC terminó, si no None."""
        if not self.vlc.vivo():
            return "fin"
        if not self.vlc.conectar():
            return None
        if not self.vlc.volumen_aplicado:
            self.vlc.poner_volumen(self.vlc.volumen)
        for ep in self.vlc.nuevos_episodios():
            if self.primer_aviso and ep == self.episodio:   # aviso del episodio con el que arranca
                self.primer_aviso = False
                continue
            self.primer_aviso = False
            log(f"Nuevo episodio: {ep}")
            self.estatica.mostrar()              # estática entre episodios, hasta que haya imagen
            self.esperando_imagen = True
            self.episodio, self.seg = ep, 0
        t = ahora()
        if self.esperando_imagen:
            n = self.vlc.cuadros_mostrados()
            if n:
                log(f"VLC muestra imagen ({n} cuadros): ocultar estática")
                self.estatica.ocultar()
                self.esperando_imagen = False
        elif t - self.t_consulta >= 1.0:
            self.t_consulta = t
            s = self.vlc.segundo()
            if s is not None:
                self.seg = s
        if t - self.t_guardado >= 5.0:
            self.t_guardado = t
            self.estado.recordar(self.serie, self.episodio, self.seg)
            self.estado.guardar()
        return None

    def volumen(self, delta):
        v = max(0, min(100, self.vlc.volumen + delta))
        self.vlc.poner_volumen(v)
        self.estado.datos["volumen"] = v
        log(f"Volumen {v}%")

    def parar(self):
        s = self.vlc.segundo() if self.vlc.vivo() else None
        if s is not None:
            self.seg = s
        self.estado.recordar(self.serie, self.episodio, self.seg)
        self.estado.guardar()
        self.vlc.cerrar()
        log(f"Guardado {self.serie.rotulo}: {self.episodio} en el segundo {self.seg}")


class CanalTV:
    """Categoría TV: un canal en vivo. "Todo" (canal=None) mezcla todas las series; los canales de
    ~/videos/canales.txt (Cartoon Network, Nickelodeon...) solo las suyas. Episodios al azar, sin
    repetir hasta haber pasado por todos (vistos por canal en estado.json). No toca el "Seguir".
    En pantalla: rótulo arriba a la derecha al empezar cada episodio, la mosca del canal abajo a la
    derecha (siempre) y "Más adelante: ..." abajo a la izquierda (al empezar y en el último minuto).
    Misma interfaz que Reproduccion."""

    SEGUNDOS_ROTULO = 3.0
    SEGUNDOS_PROXIMO = 8.0
    PROXIMO_TRAS = 6.0          # "Más adelante" a los 6 s de empezar el episodio...
    PROXIMO_FINAL = 60          # ...y otra vez en el último minuto

    def __init__(self, series, estado, estatica, dibujos, canal=None):
        """dibujos: el Menú (rotulo_tv, mosca_tv, proximo_tv). canal: nombre o None (= Todo)."""
        self.canal = canal
        self.nombre_canal = canal or "TV"
        self.series = {s.id: s for s in series if s.episodios}
        self.estado, self.estatica, self.dibujos = estado, estatica, dibujos
        self.capas = {}                 # "rotulo" / "mosca" / "proximo" -> proceso minitv-rotulo
        self.actual = None              # "id_serie/episodio" que se está viendo
        self.mosca_de = None            # canal cuya mosca está puesta (en "Todo" cambia con la serie)
        self.vlc = None
        self._lanzar()

    def _memoria(self):
        if self.canal is None:
            return self.estado.datos.setdefault("tv", {})
        return self.estado.datos.setdefault("tv_canales", {}).setdefault(self.canal, {})

    def _mazo(self):
        """Episodios que faltan en esta vuelta, barajados (si no queda ninguno, empieza otra vuelta)."""
        tv = self._memoria()
        todos = [f"{sid}/{e}" for sid, s in self.series.items() for e in s.episodios]
        vistos = tv.get("vistos", [])
        pendientes = [x for x in todos if x not in set(vistos)]
        if not pendientes:
            log(f"{self.nombre_canal}: se vieron todos los episodios; empieza otra vuelta")
            tv["vistos"], pendientes = [], todos
        random.shuffle(pendientes)
        if len(pendientes) > 1 and vistos and pendientes[0] == vistos[-1]:   # sin repetir el último
            pendientes.append(pendientes.pop(0))
        return pendientes

    def _lanzar(self):
        self.mazo = self._mazo()
        items = [(os.path.join(self.series[c.split("/", 1)[0]].carpeta, c.split("/", 1)[1]), 0) for c in self.mazo]
        self.vlc = VLC(items, volumen=self.estado.datos.get("volumen", 100), bucle=False)
        self.estatica.mostrar()
        self.esperando_imagen = True
        self.actual = None
        log(f"{self.nombre_canal}: {len(self.mazo)} episodios por ver en esta vuelta")

    # ----- capas de texto encima del video (minitv-rotulo) -----
    def _capa(self, nombre, img, x, y, segundos):
        # El firmware lee la imagen con filas de un múltiplo de 16 píxeles: si el ancho no lo es, cada
        # fila sale corrida y la imagen se ve rayada. Se rellena con transparente hacia el lado libre.
        falta = -img.width % 16
        if falta:
            ancha = Image.new("RGBA", (img.width + falta, img.height), (0, 0, 0, 0))
            izquierda = x - falta >= 0 and x + img.width > W // 2      # pegado a la derecha: rellenar a la izquierda
            ancha.paste(img, (falta if izquierda else 0, 0))
            img, x = ancha, (x - falta if izquierda else x)
        ruta = os.path.join(RUN, f"rotulo-{nombre}.rgba")
        with open(ruta, "wb") as f:
            f.write(img.tobytes())
        self._quitar(nombre)
        if os.path.exists(ROTULO_PROG):
            self.capas[nombre] = subprocess.Popen([ROTULO_PROG, ruta, str(img.width), str(img.height),
                                                   str(x), str(y), str(segundos)])

    def _quitar(self, nombre=None):
        for n in ([nombre] if nombre else list(self.capas)):
            p = self.capas.pop(n, None)
            if p and p.poll() is None:
                p.terminate()

    def _texto(self, item):
        sid, ep = item.split("/", 1)
        return f"{self.series[sid].nombre} {capitulo(ep)}"

    def _al_empezar_episodio(self):
        img = self.dibujos.rotulo_tv(f"{self.nombre_canal} · {self._texto(self.actual)}")
        self._capa("rotulo", img, W - img.width - 6, 6, self.SEGUNDOS_ROTULO)
        # La mosca queda puesta todo el rato. En "Todo", la del canal de la serie que se está viendo.
        canal = self._canal_mosca()
        m = self.capas.get("mosca")
        if canal != self.mosca_de or (canal and (m is None or m.poll() is not None)):
            self._quitar("mosca")
            self.mosca_de = canal
            if canal:
                img = self.dibujos.mosca_tv(canal)
                x = 5 if self._mosca_izquierda() else W - img.width - 5
                self._capa("mosca", img, x, H - img.height - 5, 86400)
        self.t_episodio = self.t_consulta = ahora()
        self.duracion = None
        self.proximo_inicio = self.proximo_final = False

    def info(self):
        """Botón OK del control remoto: vuelve a mostrar qué se ve y qué viene."""
        if self.actual:
            img = self.dibujos.rotulo_tv(f"{self.nombre_canal} · {self._texto(self.actual)}")
            self._capa("rotulo", img, W - img.width - 6, 6, self.SEGUNDOS_ROTULO)
            self._proximo()

    def _proximo(self):
        if self.mazo:
            img = self.dibujos.proximo_tv(self._texto(self.mazo[0]))
            x = W - img.width - 6 if self._mosca_izquierda() else 6     # en el lado contrario a la mosca
            self._capa("proximo", img, x, H - img.height - 6, self.SEGUNDOS_PROXIMO)

    def _canal_mosca(self):
        """El canal de la mosca: el elegido o, en "Todo", el primero de canales.txt con esta serie."""
        if self.canal or not self.actual:
            return self.canal
        sid = self.actual.split("/", 1)[0]
        for nombre, suyas in leer_canales(list(self.series.values())):
            if any(s.id == sid for s in suyas):
                return nombre
        return None

    def _mosca_izquierda(self):
        """canales.txt: "mosca: izquierda" debajo del [Canal] la pone abajo a la izquierda."""
        return bool(self.mosca_de) and \
            getattr(leer_canales, "opciones", {}).get(self.mosca_de, {}).get("mosca") == "izquierda"

    def tick(self):
        """Devuelve 'fin' si VLC falló, si no None. Al terminar el mazo, baraja otra vuelta."""
        if not self.vlc.vivo():
            if ahora() - self.vlc.t_inicio < 5:
                return "fin"
            self._quitar("rotulo")
            self._quitar("proximo")
            self._lanzar()
            return None
        if not self.vlc.conectar():
            return None
        if not self.vlc.volumen_aplicado:
            self.vlc.poner_volumen(self.vlc.volumen)
        for ep in self.vlc.nuevos_episodios():
            i = next((k for k, c in enumerate(self.mazo) if c.split("/", 1)[1] == ep), None)
            if i is None:
                continue
            if self.actual is not None:                 # cambio de episodio: estática hasta que haya imagen
                self._quitar("rotulo")
                self._quitar("proximo")
                self.estatica.mostrar()
                self.esperando_imagen = True
            self._empieza(i)
        if self.esperando_imagen:
            n = self.vlc.cuadros_mostrados()
            if n:
                if self.actual is None and self.mazo:
                    # El aviso del primer episodio llegó antes de conectarse a VLC (pasa si VLC arranca
                    # lento): es el primero del mazo, que es lo primero que reproduce
                    self._empieza(0)
                self.estatica.ocultar()
                self.esperando_imagen = False
                if self.actual:
                    self._al_empezar_episodio()
        elif self.actual:
            t = ahora()
            if not self.proximo_inicio and t - self.t_episodio >= self.PROXIMO_TRAS:
                self.proximo_inicio = True
                self._proximo()
            if not self.proximo_final and t - self.t_consulta >= 3:
                self.t_consulta = t
                if self.duracion is None:
                    d = self.vlc.consulta("get_length", rb"^\s*(\d+)\s*$")
                    self.duracion = int(d) if d else None
                s = self.vlc.segundo()
                if self.duracion and s is not None and self.duracion - s <= self.PROXIMO_FINAL:
                    self.proximo_final = True
                    self._proximo()
        return None

    def _empieza(self, i):
        self.actual, self.mazo = self.mazo[i], self.mazo[i + 1:]
        self._memoria().setdefault("vistos", []).append(self.actual)
        self.estado.guardar()
        log(f"{self.nombre_canal}: {self.actual}")

    def volumen(self, delta):
        v = max(0, min(100, self.vlc.volumen + delta))
        self.vlc.poner_volumen(v)
        self.estado.datos["volumen"] = v
        log(f"Volumen {v}%")

    def parar(self):
        self._quitar()
        self.vlc.cerrar()
        self.estado.guardar()
        log(f"{self.nombre_canal}: fin")


def leer_canales(series, _cache={}):
    """Canales de ~/videos/canales.txt: [(nombre, [Serie...])], solo los que tienen series con episodios.
    Se relee si el archivo cambia."""
    ruta = os.path.join(VIDEO_DIR, "canales.txt")
    try:
        fecha = os.path.getmtime(ruta)
    except OSError:
        return []
    if _cache.get("fecha") != fecha:
        canales, actual, opciones = [], None, {}
        try:
            with open(ruta, encoding="utf-8", errors="replace") as f:
                for linea in f:
                    linea = unicodedata.normalize("NFC", linea.strip())
                    if not linea or linea.startswith("#"):
                        continue
                    if linea.startswith("[") and linea.endswith("]"):
                        actual = (linea[1:-1].strip(), [])
                        canales.append(actual)
                    elif actual and linea.lower().replace(" ", "").startswith("mosca:"):
                        opciones[actual[0]] = {"mosca": linea.split(":", 1)[1].strip().lower()}
                    elif actual:
                        actual[1].append(linea.lower())
        except OSError:
            canales = []
        _cache.update(fecha=fecha, canales=canales, opciones=opciones)
    leer_canales.opciones = _cache.get("opciones", {})
    por_nombre = {unicodedata.normalize("NFC", s.nombre).lower(): s for s in series if s.episodios}
    out = []
    for nombre, nombres in _cache["canales"]:
        suyas = [por_nombre[n] for n in nombres if n in por_nombre]
        if suyas:
            out.append((nombre, suyas))
    return out


