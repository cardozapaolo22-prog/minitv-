    # ----- Música: pantalla "Ahora suena" -----
    def _partir(self, d, texto, fuente, ancho, lineas_max):
        """Parte un texto en líneas que quepan en 'ancho' (la última con … si no cabe)."""
        palabras, out, actual = texto.split(), [], ""
        for p in palabras:
            prueba = f"{actual} {p}".strip()
            if d.textsize(prueba, font=fuente)[0] <= ancho or not actual:
                actual = prueba
            else:
                out.append(actual)
                actual = p
        if actual:
            out.append(actual)
        if len(out) > lineas_max:
            out = out[:lineas_max - 1] + [" ".join(out[lineas_max - 1:])]
        return [recortar(d, l, fuente, ancho) for l in out]

