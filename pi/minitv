class TV:
    def __init__(self):
        self.salir = False
        signal.signal(signal.SIGTERM, self._terminar)
        signal.signal(signal.SIGINT, self._terminar)
        self.estado = Estado()
        self.series = buscar_series()
        self.consolas = buscar_consolas()
        self.partida = None                        # juego en curso (RetroArch)
        self.aviso = None                          # (texto, hasta): aviso temporal abajo del menú
        self.bt = Bluetooth()                      # Ajustes → Bluetooth
        self.spotify = Spotify()                   # Música: Spotify Connect
        self.telefono = TelefonoBT()               # Música: el teléfono por Bluetooth ("Mini TV")
        self.fuente = None                         # fuente de la música en pantalla
        self.tras_musica = None                    # qué retomar al volver de la música ("TV" o una Serie)
        self.fb = Framebuffer()
        self.fb.negro()
        self.estatica = Estatica()                 # tubo de encendido -> estática
        self.menu = Menu(self)
        if self.estado.datos.get("ultimo_modo") == "tv":
            self.menu.seleccionar_tv()
        else:
            self.menu.seleccionar_serie(self.estado.datos.get("ultima"))
        self.control = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        try:
            os.unlink(SOCK_CONTROL)
        except OSError:
            pass
        self.control.bind(SOCK_CONTROL)
        os.chmod(SOCK_CONTROL, 0o660)
        self.control.setblocking(False)
        self.cola_botones = queue.Queue()
        botones = []
        if BOTON1_GPIO is not None:
            botones.append((BOTON1_GPIO, "menu", "apagar", 2.0))
        if BOTON2_GPIO is not None:
            botones.append((BOTON2_GPIO, "abajo", "elegir", 0.8))
        if botones:
            LectorBotones(botones, self.cola_botones).start()
            log("Botones activos: " + ", ".join(f"GPIO{g}" for g, *_ in botones))
        try:                                       # mandos (Joy-Con, Mando Pro...) y teclados en el menú
            LectorMandos(self.cola_botones, lambda: self.modo != "juego").start()
        except ImportError:
            log("Sin python3-evdev: el menú solo responde a los botones")
        self.repro = None
        self.p_apagado = None                      # reposo: minitv-estatica apagado (pantalla negra)
        self._remoto_previo = None                 # último estado escrito en remoto.json
        self.vlc_aux = None                        # VLC de "SIN SEÑAL"
        self.modo = "menu"
        # tubo (0,55 s) + logo (2 s) + un poco de estática "sintonizando" antes del menú
        self.t_ocultar_estatica = ahora() + (3.4 if os.path.exists(LOGO_ARRANQUE) else 1.6)
        self.t_input = self.t_ocultar_estatica
        self.t_cuadro = 0
        self.t_aux = 0
        log(f"Inicio: {len(self.series)} series en {VIDEO_DIR}")

    def _terminar(self, *_):
        self.salir = True

    # ----- órdenes -----
    def ordenes(self):
        """Órdenes pendientes: de los botones físicos y del socket de minitv-control."""
        out = []
        while True:
            try:
                orden, origen = self.cola_botones.get_nowait()
                log(f"{origen} -> {orden}")
                out.append(orden)
            except queue.Empty:
                break
        while True:
            try:
                out.append(self.control.recv(64).decode("utf-8", "replace").strip().lower())
            except BlockingIOError:
                return out

    REMOTAS = {"sube", "baja", "izquierda", "derecha", "ok", "atras", "inicio", "pausa", "stop",
               "vol+", "vol-", "encendido"}

    def traducir(self, ords):
        """Órdenes del control remoto -> órdenes según lo que se está viendo (las demás pasan igual)."""
        out = []
        for o in ords:
            if o not in self.REMOTAS:
                out.append(o)
                continue
            if o == "encendido":
                out.append("despertar" if self.modo == "reposo" else "reposo")
                continue
            if self.modo == "menu":
                if o == "izquierda" and self.menu.dentro():
                    o = "menu"
                else:
                    o = {"sube": "arriba", "baja": "abajo", "ok": "elegir", "atras": "menu",
                         "izquierda": "lado-", "derecha": "lado+", "inicio": "inicio",
                         "vol+": "vol+", "vol-": "vol-"}.get(o)
            elif self.modo == "tv":
                o = {"sube": "canal+", "baja": "canal-", "ok": "info", "atras": "menu", "inicio": "menu",
                     "stop": "menu", "pausa": "pausa", "vol+": "girar+", "vol-": "girar-"}.get(o)
            elif self.modo == "juego":
                o = {"atras": "menu", "inicio": "menu", "stop": "menu", "vol+": "girar+", "vol-": "girar-"}.get(o)
            elif self.modo == "musica":
                o = {"atras": "menu", "inicio": "menu", "stop": "menu"}.get(o)
            elif self.modo == "sin_senal":
                o = "menu"
            else:
                o = None
            if o:
                out.append(o)
        return out

    def cambiar_canal(self, d):
        """▲ ▼ del control durante un episodio: canal siguiente / anterior (en TV: Todo y los canales
        de canales.txt; viendo una serie: la serie siguiente / anterior)."""
        if isinstance(self.repro, CanalTV):
            lista = [None] + [n for n, _ in leer_canales(self.series)]
            i = lista.index(self.repro.canal) if self.repro.canal in lista else 0
            self.repro.parar()
            self.repro = None
            self.estatica.mostrar()
            self.ver_tv(lista[(i + d) % len(lista)])
        elif self.repro:
            lista = [s for s in self.series if s.episodios]
            i = next((k for k, s in enumerate(lista) if s.id == self.repro.serie.id), 0)
            self.repro.parar()
            self.repro = None
            self.estatica.mostrar()
            if lista:
                self.ver(lista[(i + d) % len(lista)])

    def reposo(self):
        """Botón rojo del control: la TV se "apaga" con la animación de tubo y queda en negro, sin
        apagar la Pi (así el control la puede volver a encender)."""
        log("Reposo (desde el control remoto)")
        if self.repro:
            self.repro.parar()
            self.repro = None
        if self.partida:
            self.partida.parar()                   # que RetroArch guarde la partida antes
            self.partida = None
        if self.modo == "musica":
            self.salir_musica(cortar=True)
            if self.repro:
                self.repro.parar()
                self.repro = None
        self.cerrar_aux()
        self.menu.remoto_pantalla = False
        self.estado.guardar()
        self.p_apagado = subprocess.Popen([ESTATICA, "apagado"])
        self.modo = "reposo"

    def despertar(self):
        log("Encendido (desde el reposo)")
        self.estatica.cerrar()
        self.estatica = Estatica()                 # tubo de encendido + logo, como al arrancar
        time.sleep(0.4)
        if self.p_apagado:
            self.p_apagado.terminate()
            try:
                self.p_apagado.wait(timeout=2)
            except subprocess.TimeoutExpired:
                self.p_apagado.kill()
            self.p_apagado = None
        self.series = buscar_series()
        self.consolas = buscar_consolas()
        if self.estado.datos.get("ultimo_modo") == "tv":
            self.menu.seleccionar_tv()
        else:
            self.menu.seleccionar_serie(self.estado.datos.get("ultima"))
        self.modo = "menu"
        self.t_ocultar_estatica = ahora() + (3.4 if os.path.exists(LOGO_ARRANQUE) else 1.6)
        self.t_input = self.t_ocultar_estatica
        self.t_cuadro = 0

    def paso_reposo(self, ords):
        for o in ords:
            if o == "apagar":                      # botón 1 mantenido: apagar de verdad
                if self.p_apagado:
                    self.p_apagado.terminate()
                    self.p_apagado = None
                self.apagar()
                return
            if o in ("despertar", "menu", "elegir", "arriba", "abajo"):
                self.despertar()
                return

    def publicar_estado(self):
        """/run/minitv/remoto.json: lo lee el control remoto del teléfono (minitv-remoto)."""
        titulo = ""
        if self.modo == "tv" and self.repro:
            titulo = self.repro.nombre_canal if isinstance(self.repro, CanalTV) else self.repro.serie.nombre
        elif self.modo == "juego" and self.partida:
            titulo = self.partida.consola.titulo(self.partida.juego)
        vlc = getattr(self.repro, "vlc", None) if self.modo == "tv" else None
        datos = {"modo": self.modo, "volumen": self.estado.datos.get("volumen", 100), "titulo": titulo,
                 "pausa": bool(getattr(vlc, "en_pausa", False))}
        if datos != self._remoto_previo:
            self._remoto_previo = datos
            try:
                tmp = os.path.join(RUN, "remoto.json.tmp")
                with open(tmp, "w", encoding="utf-8") as f:
                    json.dump(datos, f, ensure_ascii=False)
                os.replace(tmp, os.path.join(RUN, "remoto.json"))
            except OSError:
                pass

    def ultima_serie(self):
        ids = {s.id: s for s in self.series if s.episodios}
        u = self.estado.datos.get("ultima")
        return ids.get(u) or next(iter(ids.values()), None)

    def reanudable(self):
        """Lo que se reanuda al cerrar el menú o por inactividad: 'TV' (si fue lo último que se vio)
        o la última serie (objeto Serie), o None."""
        if self.estado.datos.get("ultimo_modo") == "tv" and any(s.episodios for s in self.series):
            return "TV"
        return self.ultima_serie()

    def reanudar(self, que):
        self.ver_tv(self.estado.datos.get("ultimo_canal")) if que == "TV" else self.ver(que)

    # ----- transiciones -----
    def ver(self, serie, inicio=None):
        self._liberar_audio()
        self.estatica.mostrar()
        if not serie.episodios:
            self.sin_senal()
            return
        self.repro = Reproduccion(serie, self.estado, self.estatica, inicio)
        self.estado.datos["ultimo_modo"] = "serie"
        self.estado.guardar()
        self.modo = "tv"

    def ver_tv(self, canal=None):
        """Categoría TV: "Todo" (canal=None) o un canal de canales.txt (si ya no existe, "Todo")."""
        self._liberar_audio()
        suyas = dict(leer_canales(self.series)).get(canal) if canal else None
        if canal and not suyas:
            canal = None
        self.repro = CanalTV(suyas or self.series, self.estado, self.estatica, self.menu, canal)
        self.estado.datos["ultimo_modo"] = "tv"
        self.estado.datos["ultimo_canal"] = canal
        self.estado.guardar()
        self.modo = "tv"

    def jugar(self, consola, juego, nuevo=False):
        """nuevo=True: desde el principio, sin cargar el estado guardado."""
        self._liberar_audio()
        self.estatica.mostrar(self.menu.rotulo_carga(consola, juego))   # estática + "Cargando…"
        self.partida = Partida(consola, juego, self.estado, self.estatica, nuevo=nuevo)
        self.modo = "juego"

    def abrir_menu(self, consola_id=None):
        """consola_id: al volver de un juego, abre la lista de juegos de esa consola."""
        self.estatica.mostrar()
        if self.repro:
            self.repro.parar()
            self.repro = None
        if self.partida:
            consola_id = self.partida.consola.id
            self.partida.parar()
            self.partida = None
            self.estado.guardar()
        self.cerrar_aux()
        self.series = buscar_series()
        self.consolas = buscar_consolas()
        if consola_id:
            self.menu.seleccionar_juego(consola_id)
        elif self.estado.datos.get("ultimo_modo") == "tv":
            self.menu.seleccionar_tv()
        else:
            self.menu.seleccionar_serie(self.estado.datos.get("ultima"))
        self.modo = "menu"
        self.t_ocultar_estatica = ahora() + 0.5
        self.t_input = self.t_ocultar_estatica
        log("Menú")

    def sin_senal(self):
        log("SIN SEÑAL")
        self.cerrar_aux()
        if os.path.exists(SIN_SENAL):
            self.vlc_aux = VLC([(SIN_SENAL, 0)], audio=False)
        self.modo = "sin_senal"
        self.t_aux = ahora()

    def cerrar_aux(self):
        if self.vlc_aux:
            self.vlc_aux.cerrar()
            self.vlc_aux = None

    def apagar(self):
        log("Apagando")
        if self.repro:
            self.repro.parar()
            self.repro = None
        if self.partida:
            self.partida.parar()                   # que RetroArch guarde la partida antes
            self.partida = None
        self.estado.guardar()
        subprocess.Popen([ESTATICA, "apagado"])   # animación de apagado sobre lo que se ve
        time.sleep(1.0)
        subprocess.run(["sudo", "-n", "systemctl", "poweroff"])
        self.modo = "apagando"

    # ----- bucle -----
    def paso_menu(self, ords):
        for o in ords:
            self.t_input = ahora()
            if o == "reposo":
                self.reposo()
                return
            if self.menu.remoto_pantalla and o != "apagar":   # Ajustes → Control remoto: cualquier botón cierra
                self.menu.remoto_pantalla = False
                continue
            if o in ("lado-", "lado+"):
                self.menu.lado(-1 if o == "lado-" else 1)
            elif o == "inicio":
                self.menu.inicio()
            elif o in ("vol+", "vol-"):
                v = max(0, min(100, self.estado.datos.get("volumen", 100) + (5 if o == "vol+" else -5)))
                self.estado.datos["volumen"] = v
                self.estado.guardar()
                self.aviso = (f"Volumen {v}%", ahora() + 2)
            elif o == "abajo" or o == "girar+":
                self.menu.abajo()
            elif o == "arriba" or o == "girar-":
                self.menu.arriba()
            elif o == "elegir":
                accion = self.menu.elegir()
                if accion and accion[0] == "ver":
                    self.ver(accion[1])
                    return
                if accion and accion[0] == "ver_tv":
                    self.ver_tv(accion[1])
                    return
                if accion and accion[0] == "ahora_suena":
                    self.tras_musica = None
                    self.fuente = self.musica_activa()
                    self.mostrar_musica()
                    return
                if accion and accion[0] == "ver_episodio":
                    self.ver(accion[1], inicio=(accion[2], 0))
                    return
                if accion and accion[0] == "abrir_serie":
                    self.menu.abrir_serie(accion[1])
                if accion and accion[0] == "abrir_consola":
                    self.menu.abrir_consola(accion[1])
                if accion and accion[0] == "jugar":
                    self.jugar(accion[1], accion[2])
                    return
                if accion and accion[0] == "jugar_nuevo":
                    self.jugar(accion[1], accion[2], nuevo=True)
                    return
                if accion and accion[0] == "aviso":
                    self.aviso = (accion[1], ahora() + 4)
                if accion and accion[0] == "volumen_ciclo":
                    v = self.estado.datos.get("volumen", 100)
                    self.estado.datos["volumen"] = 25 if v >= 100 else min(100, (v // 25 + 1) * 25)
                    self.estado.guardar()
                if accion and accion[0] == "apagar":
                    self.apagar()
                    return
            elif o == "menu" and self.menu.bt_pantalla:     # en Bluetooth: un nivel atrás
                self.menu.volver_bt()
            elif o == "menu" and self.menu.serie_abierta:   # en la lista de episodios: volver a series
                self.menu.cerrar_serie()
            elif o == "menu" and self.menu.consola_abierta:  # en la lista de juegos: volver a consolas
                self.menu.cerrar_consola()
            elif o == "menu":                      # cerrar el menú = volver a la última serie (o a TV)
                r = self.reanudable()
                if r:
                    self.reanudar(r)
                    return
            elif o == "apagar":
                self.apagar()
                return
        t = ahora()
        restante = ESPERA_REANUDAR - (t - self.t_input)
        # En Juegos no se reanuda la serie sola: quien está ahí quiere elegir un juego
        # En Bluetooth tampoco: puede estar esperando a que se escriba un código
        # ...ni mientras suena Spotify (la TV le quitaría el audio)
        ultima = (None if self.menu.en_juegos() or self.menu.bt_pantalla or self.musica_activa()
                  or self.bt.visible() or self.menu.remoto_pantalla else self.reanudable())
        nombre = ((self.estado.datos.get("ultimo_canal") or "TV") if ultima == "TV"
                  else getattr(ultima, "nombre", ""))
        if ultima and restante <= 0 and not self.estatica.visible:
            log(f"Sin actividad: reanudar {nombre}")
            self.reanudar(ultima)
            return
        intervalo = 1 / 30 if self.menu.animando() else 1 / 10
        if t - self.t_cuadro >= intervalo:
            self.t_cuadro = t
            aviso = (f"Reanudando {nombre} en {math.ceil(restante)}…"
                     if ultima and not self.estatica.visible else None)
            if self.aviso and t < self.aviso[1]:
                aviso = self.aviso[0]
            self.fb.mostrar(self.menu.dibujar(aviso))
        if self.estatica.visible and t >= self.t_ocultar_estatica:
            self.estatica.ocultar()
            self.t_input = t

    def paso_tv(self, ords):
        for o in ords:
            if o in ("menu", "elegir"):          # cualquier botón del mando abre el menú
                self.abrir_menu()
                return
            if o == "reposo":
                self.reposo()
                return
            if o in ("canal+", "canal-"):
                self.cambiar_canal(1 if o == "canal+" else -1)
                return
            if o == "info" and isinstance(self.repro, CanalTV):
                self.repro.info()
            if o == "pausa":
                self.repro.vlc.pausa()
            if o == "apagar":
                self.apagar()
                return
            if o in ("girar+", "girar-"):
                self.repro.volumen(5 if o == "girar+" else -5)
        if self.repro.tick() == "fin":
            corto = ahora() - self.repro.vlc.t_inicio < 5
            log("VLC terminó" + (" enseguida: error" if corto else ""))
            self.repro.parar()
            self.repro = None
            self.estatica.mostrar()
            if corto:
                self.sin_senal()
            else:
                self.abrir_menu()

    def paso_juego(self, ords):
        for o in ords:
            if o == "menu":                        # botón 1 corto: volver a la TV (RetroArch guarda)
                self.abrir_menu()
                return
            if o == "reposo":
                self.reposo()
                return
            if o == "apagar":
                self.apagar()
                return
            if o in ("girar+", "girar-"):
                self.partida.volumen(5 if o == "girar+" else -5)
        if self.partida.tick() == "fin":           # salió solo (Esc, Select+Start) o falló
            p = self.partida
            corto = ahora() - p.t_inicio < 4
            log(f"RetroArch terminó (código {p.proc.returncode})" + (": no pudo abrir el juego" if corto else ""))
            self.abrir_menu()
            if corto:
                self.aviso = (f"No se pudo abrir {p.consola.titulo(p.juego)}", ahora() + 5)

    # ----- Música (Spotify Connect) -----
    def musica_activa(self):
        """La fuente de música que está sonando (o en pausa en la TV), o None."""
        return next((f for f in (self.telefono, self.spotify) if f.activo()), None)

    def _liberar_audio(self):
        """Antes de un episodio o un juego: si suena música, cortarla (la tarjeta de audio no se comparte)."""
        f = self.musica_activa()
        if f:
            f.cortar()
            time.sleep(0.3)

    def atender_spotify(self):
        """Fuentes de música: el teléfono por Bluetooth y Spotify Connect (desactivado, ver memoria)."""
        for fuente in (self.telefono, self.spotify):
            cambios = fuente.poll()
            if "volumen" in cambios and fuente.volumen is not None:
                v = round(fuente.volumen * 100 / 65535)          # el volumen del teléfono es el de la TV
                if v != self.estado.datos.get("volumen"):
                    self.estado.datos["volumen"] = v
                    self.estado.guardar()
                    log(f"Volumen {v}% (desde {fuente.origen})")
            if "estado" in cambios:
                log(f"{fuente.origen}: {fuente.estado}")
                if fuente.sonando() and self.modo in ("tv", "menu", "sin_senal"):
                    self.entrar_musica(fuente)
                elif self.modo == "musica" and fuente is self.fuente and not fuente.activo():
                    self.salir_musica(cortar=False)         # se terminó o se desconectó

    def entrar_musica(self, fuente):
        """Empieza la música: guarda lo que se veía (se retoma con el botón 1) y libera el audio."""
        self.fuente = fuente
        self.tras_musica = None
        if self.repro:
            self.tras_musica = "TV" if isinstance(self.repro, CanalTV) else self.repro.serie
            self.repro.parar()                              # guarda el segundo exacto del episodio
            self.repro = None
        self.cerrar_aux()
        if hasattr(fuente, "iniciar_audio"):
            fuente.iniciar_audio()                          # el teléfono: recién ahora, con el audio libre
        self.mostrar_musica()

    def mostrar_musica(self):
        self.estatica.mostrar()
        self.modo = "musica"
        self.t_ocultar_estatica = ahora() + 0.4
        self.t_cuadro = 0
        log("Ahora suena" + (f" (después: {getattr(self.tras_musica, 'nombre', self.tras_musica)})"
                             if self.tras_musica else ""))

    def salir_musica(self, cortar=True):
        if self.fuente:
            if cortar:
                self.fuente.cortar()
            elif hasattr(self.fuente, "detener_audio"):
                self.fuente.detener_audio()
        destino, self.tras_musica = self.tras_musica, None
        if destino:
            self.estatica.mostrar()
            self.reanudar(destino)
        else:
            self.abrir_menu()

    def paso_musica(self, ords):
        for o in ords:
            if o == "menu":                                 # botón 1: volver a la TV
                self.salir_musica(cortar=True)
                return
            if o == "reposo":
                self.reposo()
                return
            if o == "apagar":
                self.apagar()
                return
        t = ahora()
        if t - self.t_cuadro >= 0.25:
            self.t_cuadro = t
            self.fb.mostrar(self.menu.dibujar_ahora_suena(self.fuente or self.telefono))
        if self.estatica.visible and t >= self.t_ocultar_estatica:
            self.estatica.ocultar()

    def paso_sin_senal(self, ords):
        if self.estatica.visible and self.vlc_aux and self.vlc_aux.conectar():
            if self.vlc_aux.cuadros_mostrados():
                self.estatica.ocultar()
        if "reposo" in ords:
            self.reposo()
        elif "apagar" in ords:
            self.cerrar_aux()
            self.apagar()
        elif ords or ahora() - self.t_aux > 5:
            self.abrir_menu()

    def bucle(self):
        while not self.salir:
            ords = self.traducir(self.ordenes())
            self.atender_spotify()
            self.bt.revisar(self.menu.bt_pantalla is not None)
            if ords:
                log("Órdenes:", ", ".join(ords))
            if self.modo == "menu":
                self.paso_menu(ords)
            elif self.modo == "tv":
                self.paso_tv(ords)
            elif self.modo == "sin_senal":
                self.paso_sin_senal(ords)
            elif self.modo == "juego":
                self.paso_juego(ords)
            elif self.modo == "musica":
                self.paso_musica(ords)
            elif self.modo == "reposo":
                self.paso_reposo(ords)
            self.publicar_estado()
            time.sleep(0.01 if self.modo == "menu" and self.menu.animando() else 0.03)
        self.cerrar()

    def cerrar(self):
        log("Saliendo")
        if self.repro:
            self.repro.parar()
        if self.partida:
            self.partida.parar()
        self.telefono.detener_audio()
        self.bt.cerrar_sesion()
        self.cerrar_aux()
        self.estado.guardar()
        self.estatica.cerrar()
        self.fb.negro()
        try:
            os.unlink(SOCK_CONTROL)
        except OSError:
            pass


if __name__ == "__main__":
    TV().bucle()
