    def logo_canal(self, canal, alto, ancho=None, _cache={}):
        """Logo del canal (~/videos/logos/<Canal>.png) que quepa en ancho x alto, RGBA; None si no hay.
        Sin ancho: alto fijo. Los logos casi cuadrados quedan más altos que los alargados."""
        ruta = os.path.join(LOGOS_DIR, canal + ".png")
        try:
            fecha = os.path.getmtime(ruta)
        except OSError:
            return None
        clave = (ruta, alto, ancho)
        if clave not in _cache or _cache[clave][0] != fecha:
            try:
                im = Image.open(ruta).convert("RGBA")
                esc = alto / im.height if ancho is None else min(alto / im.height, ancho / im.width)
                im = im.resize((max(1, round(im.width * esc)), max(1, round(im.height * esc))), Image.LANCZOS)
            except OSError:
                im = None
            _cache[clave] = (fecha, im)
        return _cache[clave][1]

    def _emblema(self, texto, w, h, _cache={}):
        """Recuadro con siglas para "Todo" y los canales sin logo ("TV", "DC", "FOX")."""
        clave = (texto, w, h)
        if clave not in _cache:
            pal = texto.split()
            siglas = texto.upper() if len(pal) == 1 and len(texto) <= 4 else "".join(p[0] for p in pal).upper()[:3]
            im = Image.new("RGBA", (w, h), (0, 0, 0, 0))
            d = ImageDraw.Draw(im)
            rect_redondeado(d, (0, 0, w - 1, h - 1), min(6, h // 3), GRIS_AZUL + (60,), GRIS_AZUL + (255,))
            f = self.f_sel if h >= 30 else self.f_mosca
            tw, th = d.textsize(siglas, font=f)
            d.text(((w - tw) // 2, (h - th) // 2 - 1), siglas, font=f, fill=BLANCO + (255,))
            _cache[clave] = im
        return _cache[clave]

    def _fila_canal(self, img, d, nombre, sub, y, dist, es_todo):
        """Sección TV: el logo completo a la izquierda (o un recuadro con siglas) y el texto a la derecha."""
        grande = self.foco >= 0 and abs(dist) < 0.5
        bw, bh = (64, 36) if grande else (52, 20)
        logo = None if es_todo else self.logo_canal(nombre, bh, bw)
        if logo is None:
            logo = self._emblema("TV" if es_todo else nombre, bw, bh)
        cx = 26 + (64 - logo.width) // 2
        tx, ancho = 98, W - 16 - 98 - 10
        if grande:
            img.paste(logo, (cx, y + (self.ALTO_GEL - logo.height) // 2), logo)
            d.text((tx, y + 6), recortar(d, nombre, self.f_sel, ancho), font=self.f_sel, fill=BLANCO)
            d.text((tx + 1, y + 26), recortar(d, sub, self.f_sub, ancho), font=self.f_sub,
                   fill=mezcla(GEL, BLANCO, 0.8))
        else:
            k = max(0.12, 0.85 - 0.22 * max(0.0, dist - 1)) if dist >= 0 else max(0.0, 1 + dist) * 0.6
            tenue = logo.copy()
            tenue.putalpha(tenue.getchannel("A").point(lambda a: int(a * min(1.0, k + 0.15))))
            img.paste(tenue, (cx, y + 13 - logo.height // 2 + 6), tenue)
            d.text((tx, y + 12), recortar(d, nombre, self.f_item, ancho), font=self.f_item,
                   fill=mezcla(FONDO, GRIS_AZUL, k))

    def mosca_tv(self, texto):
        """Mosca del canal (esquina inferior derecha, todo el rato): su logo semitransparente o, si no
        tiene, el nombre en negrita."""
        logo = self.logo_canal(texto, 34, 72)
        if logo and logo.width * logo.height > 1500:      # todas las moscas ocupan más o menos lo mismo
            k = (1500 / (logo.width * logo.height)) ** 0.5
            logo = self.logo_canal(texto, round(logo.height * k), round(logo.width * k) + 1)
        if logo:
            img = logo.copy()
            img.putalpha(img.getchannel("A").point(lambda a: a * 150 // 255))
            return img
        medir = ImageDraw.Draw(Image.new("RGBA", (1, 1)))
        tw, th = medir.textsize(texto, font=self.f_mosca)
        img = Image.new("RGBA", (tw + 10, th + 6), (0, 0, 0, 0))
        d = ImageDraw.Draw(img)
        rect_redondeado(d, (0, 0, img.width - 1, img.height - 1), 5, (0, 0, 0, 70), None)
        d.text((6, 4), texto, font=self.f_mosca, fill=(0, 0, 0, 110))        # sombra
        d.text((5, 3), texto, font=self.f_mosca, fill=BLANCO + (150,))
        return img

    def proximo_tv(self, texto):
        """Aviso de programación: 'Más adelante:' en celeste y el próximo episodio debajo (RGBA)."""
        medir = ImageDraw.Draw(Image.new("RGBA", (1, 1)))
        texto = recortar(medir, texto, self.f_proximo, 190)
        w1, h1 = medir.textsize("Más adelante:", font=self.f_mosca)
        w2, h2 = medir.textsize(texto, font=self.f_proximo)
        img = Image.new("RGBA", (max(w1, w2) + 14, h1 + h2 + 11), (0, 0, 0, 0))
        d = ImageDraw.Draw(img)
        rect_redondeado(d, (0, 0, img.width - 1, img.height - 1), 6, FONDO + (200,), GEL_BORDE + (220,))
        d.text((7, 4), "Más adelante:", font=self.f_mosca, fill=CELESTE + (255,))
        d.text((7, 5 + h1), texto, font=self.f_proximo, fill=BLANCO + (255,))
        return img

    def _categorias(self, d):
        # Fila de categorías: la activa más grande, blanca y subrayada en celeste
        piezas = []
        for i, nombre in enumerate(self.CATEGORIAS):
            fuente = self.f_cat_act if i == self.cat else self.f_cat
            piezas.append((nombre, fuente, d.textsize(nombre, font=fuente)[0]))
        sep = 16
        x = (W - (sum(p[2] for p in piezas) + sep * (len(piezas) - 1))) // 2
        for i, (nombre, fuente, ancho) in enumerate(piezas):
            activa = i == self.cat
            y = 36 if activa else 40
            d.text((x, y), nombre, font=fuente, fill=BLANCO if activa else AZUL_GRIS)
            if activa:
                grosor = 3 if self.foco == -1 else 2
                d.rectangle((x, 56, x + ancho, 56 + grosor - 1), fill=CELESTE)
            if i < len(piezas) - 1:
                d.text((x + ancho + sep // 2 - 2, 40), "·", font=self.f_cat, fill=mezcla(FONDO, AZUL_GRIS, 0.6))
            x += ancho + sep


