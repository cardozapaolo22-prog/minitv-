        self.serie_abierta = None   # serie cuya lista de episodios se está mostrando
        self.consola_abierta = None  # consola cuya lista de juegos se está mostrando
        self.juego_abierto = None    # juego con partida guardada: Continuar / Empezar de nuevo / Borrar
        self.remoto_pantalla = False  # Ajustes → Control remoto (QR); cualquier botón la cierra
        self._red_cache = (0, None)
        self.bt_pantalla = None      # Ajustes → Bluetooth: "inicio", "buscar", "guardados" o "dispositivo"
        self.bt_mac = None           # dispositivo guardado elegido (pantalla "dispositivo")
        self.foco = 0           # -1 = fila de categorías; 0.. = elemento de la lista
        self.pos = 0.0           # posición animada de la selección
        self.anim = None         # (desde, hasta, t0)
        self.fondo = None
        self.t_fondo = 0

    # ----- contenido -----
    def elementos(self):
        if self.bt_pantalla:
            return self._elementos_bt()
        if self.serie_abierta:                    # lista de episodios de una serie
            s = self.serie_abierta
            i, _ = self.tv.estado.seguir(s)
            guardado = self.tv.estado.de(s).get("segundo", 0) if self.tv.estado.de(s).get("episodio") else 0
            actual = s.episodios[i]
            out = [(f"▶ Continuar {capitulo(actual)}", f"{titulo_episodio(actual)} · desde {mm_ss(guardado)}")]
            for k, e in enumerate(s.episodios):
                out.append((f"{capitulo(e)} · {titulo_episodio(e)}",
                            "En curso" if k == i else f"Episodio {k + 1} de {len(s.episodios)}"))
            return out
        if self.consola_abierta:                  # lista de juegos de una consola
            c = self.consola_abierta
            if self.juego_abierto:                # un juego con partida guardada: qué hacer
                fecha = c.fecha_guardado(self.juego_abierto) or "?"
                return [("▶ Continuar", f"Guardado el {fecha}"),
                        ("Empezar de nuevo", "Desde la pantalla de título"),
                        ("Borrar partida", "Quita el punto para continuar")]
            ultimo = self.tv.estado.datos["juegos"].get(c.id)
            out = []
            for k, j in enumerate(c.juegos):
                fecha = c.fecha_guardado(j)
                sub = f"Partida guardada · {fecha}" if fecha else f"Juego {k + 1} de {len(c.juegos)}"
                out.append((c.titulo(j), ("Último jugado · " + fecha) if j == ultimo and fecha else sub))
            return out
        c = self.CATEGORIAS[self.cat]
        if c == "TV":
            con_eps = [s for s in self.tv.series if s.episodios]
            if not con_eps:
                return []
            out = [("Todo", f"Todas las series al azar · {len(con_eps)} series")]
            for nombre, suyas in leer_canales(self.tv.series):
                out.append((nombre, " · ".join(s.nombre for s in suyas)))
            return out
        if c == "Música":
            out = []
            f = self.tv.musica_activa()
            if f:
                estado = "Sonando" if f.sonando() else "En pausa"
                out.append(("▶ Ahora suena", f"{estado} · {f.nombre} · {f.artistas}"))
            tel = self.tv.telefono.dispositivo
            out.append(("Conectar un teléfono", f"Conectado: {tel}" if tel
                        else "La TV aparece como «Mini TV» en su Bluetooth"))
            return out
        if c == "Juegos":
            out = []
            for con in self.tv.consolas:
                n = len(con.juegos)
                ultimo = self.tv.estado.datos["juegos"].get(con.id)
                sub = f"{n} juego{'s' if n != 1 else ''}"
                if ultimo in con.juegos:
                    sub += f" · Último: {con.titulo(ultimo)}"
                out.append((con.nombre, sub))
            return out
        if c == "Series":
            out = []
            for s in self.tv.series:
                if s.episodios:
                    i, _ = self.tv.estado.seguir(s)
                    out.append((s.nombre, f"Seguir: {capitulo(s.episodios[i])}"))
                else:
                    out.append((s.nombre, "Sin episodios"))
            return out
        if c == "Ajustes":
            return [("Volumen", f"Nivel: {self.tv.estado.datos.get('volumen', 100)}%  (elegir para cambiar)"),
                    ("Bluetooth", "Teclados, mandos y parlantes"),
                    ("Control remoto", "Usa tu celular como control y como mando"),
                    ("Apagar la TV", "Elegir para apagar")]
        return []

    def abrir_serie(self, serie):
        self.serie_abierta = serie
        self.foco, self.pos, self.anim = 0, 0.0, None

    def cerrar_serie(self):
        s, self.serie_abierta = self.serie_abierta, None
        self.seleccionar_serie(s.id)

    def abrir_consola(self, consola):
        self.consola_abierta = consola
        self.juego_abierto = None
        ultimo = self.tv.estado.datos["juegos"].get(consola.id)
        self.foco = consola.juegos.index(ultimo) if ultimo in consola.juegos else 0
        self.pos, self.anim = float(self.foco), None

    def cerrar_consola(self):
        if self.juego_abierto:                    # de la lista Continuar/Empezar: volver a los juegos
            c = self.consola_abierta
            j, self.juego_abierto = self.juego_abierto, None
            self.foco = c.juegos.index(j) if j in c.juegos else 0
            self.pos, self.anim = float(self.foco), None
            return
        c, self.consola_abierta = self.consola_abierta, None
        ids = [x.id for x in self.tv.consolas]
        self.foco = ids.index(c.id) if c.id in ids else (0 if ids else -1)
        self.pos, self.anim = float(max(self.foco, 0)), None

    def seleccionar_juego(self, consola_id):
        """Al volver de un juego: la lista de juegos de esa consola, con el foco en el último."""
        if self.bt_pantalla:
            self.salir_bt()
        self.serie_abierta = None
        self.cat = self.CATEGORIAS.index("Juegos")
        con = next((c for c in self.tv.consolas if c.id == consola_id), None)
        if con:
            self.abrir_consola(con)
        else:
            self.consola_abierta = None
            self.foco, self.pos, self.anim = (0 if self.tv.consolas else -1), 0.0, None

    def en_juegos(self):
        return self.consola_abierta is not None or (self.CATEGORIAS[self.cat] == "Juegos"
                                                     and not self.serie_abierta)

    def seleccionar_tv(self):
        if self.bt_pantalla:
            self.salir_bt()
        self.serie_abierta = self.consola_abierta = None
        self.cat = self.CATEGORIAS.index("TV")
        canales = [n for n, _ in leer_canales(self.tv.series)]
        ultimo = self.tv.estado.datos.get("ultimo_canal")
        self.foco = canales.index(ultimo) + 1 if ultimo in canales else 0
        self.pos, self.anim = float(self.foco), None

    def seleccionar_serie(self, serie_id):
        if self.bt_pantalla:
            self.salir_bt()
        self.serie_abierta = None
        self.consola_abierta = None
        self.cat = self.CATEGORIAS.index("Series")
        ids = [s.id for s in self.tv.series]
        self.foco = ids.index(serie_id) if serie_id in ids else (0 if ids else -1)
        self.pos = float(max(self.foco, 0))
        self.anim = None

    # ----- navegación -----
    def _mover(self, nuevo):
        if nuevo >= 0 and self.foco >= 0:
            self.anim = (self.pos, float(nuevo), ahora())
        else:
            self.pos = float(max(nuevo, 0))
            self.anim = None
        self.foco = nuevo

    def abajo(self):
        n = len(self.elementos())
        if self.serie_abierta or self.consola_abierta or self.bt_pantalla:   # en listas: vuelve al principio
            if n:
                self._mover((self.foco + 1) % n)
            return
        self._mover(0 if self.foco == -1 and n else (self.foco + 1 if 0 <= self.foco < n - 1 else -1))

    def arriba(self):
        n = len(self.elementos())
        if self.serie_abierta or self.consola_abierta or self.bt_pantalla:
            if n:
                self._mover((self.foco - 1) % n)
            return
        self._mover(n - 1 if self.foco == -1 and n else (self.foco - 1 if self.foco > 0 else -1))

    def elegir(self):
        """Devuelve la acción a realizar."""
        if self.bt_pantalla:
            return self._elegir_bt()
        if self.serie_abierta:
            if self.foco == 0:
                return ("ver", self.serie_abierta)                       # continuar donde quedó
            return ("ver_episodio", self.serie_abierta, self.foco - 1)  # ese episodio desde el principio
        if self.consola_abierta:
            c = self.consola_abierta
            if not os.path.exists(c.nucleo):
                return ("aviso", f"Falta el núcleo de {c.nombre}")
            if self.juego_abierto:
                j = self.juego_abierto
                if self.foco == 0:
                    return ("jugar", c, j)
                if self.foco == 1:
                    return ("jugar_nuevo", c, j)
                ruta = c.estado_guardado(j)
                if ruta:
                    os.unlink(ruta)
                    log(f"Partida borrada: {ruta}")
                self.cerrar_consola()
                return ("aviso", f"Partida borrada: {c.titulo(j)}")
            j = c.juegos[self.foco]
            if c.estado_guardado(j):              # tiene partida: preguntar qué hacer
                self.juego_abierto = j
                self.foco, self.pos, self.anim = 0, 0.0, None
                return None
            return ("jugar", c, j)
        if self.foco == -1:                     # en la fila de categorías: pasar a la siguiente
            self.cat = (self.cat + 1) % len(self.CATEGORIAS)
            self.pos, self.anim = 0.0, None
            if self.CATEGORIAS[self.cat] == "Juegos":
                self.tv.consolas = buscar_consolas()      # por si llegaron juegos nuevos
            return None
        c = self.CATEGORIAS[self.cat]
        if c == "TV" and self.foco >= 0:
            canales = [n for n, _ in leer_canales(self.tv.series)]
            return ("ver_tv", canales[self.foco - 1] if 1 <= self.foco <= len(canales) else None)
        if c == "Música" and self.foco >= 0:
            items = self.elementos()
            nombre = items[self.foco][0] if self.foco < len(items) else ""
            if nombre.startswith("▶"):
                return ("ahora_suena",)
            if nombre == "Conectar un teléfono":
                self.tv.bt.hacer_visible()
            return None
        if c == "Juegos" and self.foco < len(self.tv.consolas):
            return ("abrir_consola", self.tv.consolas[self.foco])
        if c == "Series" and self.foco < len(self.tv.series):
            s = self.tv.series[self.foco]
            return ("abrir_serie", s) if s.episodios else ("ver", s)
        if c == "Ajustes":
            if self.foco == 1:
                self.abrir_bt()
                return None
            if self.foco == 2:
                self.remoto_pantalla = True
                return None
            return ("volumen_ciclo",) if self.foco == 0 else ("apagar",)
        return None

    def animando(self):
        return self.anim is not None

    def dentro(self):
        """True si hay una lista abierta (episodios, juegos, Bluetooth): ◀ del control = atrás."""
        return bool(self.serie_abierta or self.consola_abierta or self.bt_pantalla)

    def lado(self, d):
        """Flechas ◀ ▶ del control remoto en la portada: categoría anterior / siguiente."""
        self.cat = (self.cat + d) % len(self.CATEGORIAS)
        if self.CATEGORIAS[self.cat] == "Juegos":
            self.tv.consolas = buscar_consolas()
        self.foco = 0 if self.elementos() else -1
        self.pos, self.anim = float(max(self.foco, 0)), None

    def inicio(self):
        """Botón Menú del control remoto dentro del menú: cierra listas y vuelve a la portada."""
        self.remoto_pantalla = False
        if self.bt_pantalla:
            self.salir_bt()
        self.serie_abierta = self.consola_abierta = None
        self.juego_abierto = None
        self.foco = 0 if self.elementos() else -1
        self.pos, self.anim = float(max(self.foco, 0)), None

    # ----- Ajustes → Control remoto -----
    def _red(self):
        """(modo, ssid, clave, ip) de la red; se relee cada 5 s."""
        t, datos = self._red_cache
        if datos and ahora() - t < 5:
            return datos
        conf = {"SSID": "MiniTV", "CLAVE": "", "IP": "192.168.4.1"}
        try:
            with open("/etc/minitv/red-propia.conf", encoding="utf-8") as f:
                for linea in f:
                    if "=" in linea and not linea.lstrip().startswith("#"):
                        k, v = linea.strip().split("=", 1)
                        conf[k] = v.strip().strip('"')
        except OSError:
            pass
        try:
            with open("/run/minitv-red/modo") as f:
                modo = f.read().strip()
        except OSError:
            modo = "casa"
        try:
            ip = subprocess.run(["/sbin/ip", "-4", "-o", "addr", "show", "wlan0"], capture_output=True,
                                text=True, timeout=2).stdout.split()
            ip = ip[ip.index("inet") + 1].split("/")[0] if "inet" in ip else ""
        except (OSError, subprocess.SubprocessError, ValueError, IndexError):
            ip = ""
        try:                                                 # PIN de Administrar (lo crea minitv-remoto)
            with open(os.path.expanduser("~/.config/minitv/admin.json"), encoding="utf-8") as f:
                pin = str(json.load(f).get("pin", ""))
        except (OSError, ValueError):
            pin = ""
        datos = (modo, conf["SSID"], conf["CLAVE"], ip or (conf["IP"] if modo == "propia" else ""), pin)
        self._red_cache = (ahora(), datos)
        return datos

    @staticmethod
    def _qr(texto, lado):
        """Código QR (blanco con módulos oscuros) de lado <= 'lado' píxeles, nítido (múltiplo entero)."""
        import qrcode
        q = qrcode.QRCode(border=2, box_size=1, error_correction=qrcode.constants.ERROR_CORRECT_L)
        q.add_data(texto)
        q.make(fit=True)
        im = q.make_image(fill_color="black", back_color="white").convert("RGB")
        k = max(1, lado // im.width)
        return im.resize((im.width * k, im.height * k), Image.NEAREST)

    def _panel_remoto(self, img, d):
        modo, ssid, clave, ip, pin = self._red()
        d.rectangle((0, 30, W, H), fill=FONDO)
        d.text((14, 36), "Control remoto", font=self.f_sel, fill=BLANCO)
        url = f"http://{ip}" if ip else "http://minitv.local"
        if modo == "propia":
            def esc(t):
                return "".join("\\" + c if c in '\\;,:"' else c for c in t)
            for x, texto, titulo in ((14, f"WIFI:T:WPA;S:{esc(ssid)};P:{esc(clave)};;", "1. Únete a la red"),
                                     (166, url, "2. Abre el control")):
                qr = self._qr(texto, 104)
                img.paste(qr, (x + (140 - qr.width) // 2, 78))
                tw = d.textsize(titulo, font=self.f_sub)[0]
                d.text((x + (140 - tw) // 2, 62), titulo, font=self.f_sub, fill=CELESTE)
            lineas = [(f"Red «{ssid}»  ·  clave: {clave}", BLANCO), (f"Control: {url}  o  http://minitv.local", GRIS_AZUL)]
            if pin:
                lineas.append((f"PIN para Administrar: {pin}", CELESTE))
            y = 186 if pin else 190
        else:
            qr = self._qr(url, 120)
            img.paste(qr, (14, 64))
            x = 14 + qr.width + 12
            lineas = [("Escanéalo con la cámara", CELESTE), ("del celular, o abre:", CELESTE),
                      ("http://minitv.local", BLANCO), (url if ip else "", GRIS_AZUL), ("", BLANCO),
                      ("Sin el wifi de casa, la TV", GRIS_AZUL), (f"crea su red «{ssid}»", GRIS_AZUL),
                      (f"clave: {clave}", BLANCO)]
            if pin:
                lineas.append((f"PIN Administrar: {pin}", CELESTE))
            for i, (t, color) in enumerate(lineas):
                d.text((x, 66 + i * 15), recortar(d, t, self.f_sub, W - x - 8), font=self.f_sub, fill=color)
            lineas, y = [], 0
        for i, (t, color) in enumerate(lineas):
            tw = d.textsize(t, font=self.f_sub)[0]
            d.text(((W - tw) // 2, y + i * 15), t, font=self.f_sub, fill=color)
        t = "Cualquier botón: volver"
        d.text((W - d.textsize(t, font=self.f_aviso)[0] - 10, 40), t, font=self.f_aviso, fill=GRIS_AZUL)

    # ----- dibujo -----
    def _fondo(self, t):
        """Fondo azul noche con dos ondas suaves que se mueven muy lento (se recalcula a 10 fps)."""
        if self.fondo is not None and t - self.t_fondo < 0.1:
            return self.fondo
        img = Image.new("RGB", (W, H), FONDO)
        d = ImageDraw.Draw(img)
        for color, base, amp, largo, vel, fase in ((ONDA_1, 192, 9, 0.022, 0.25, 0.0),
                                                  (ONDA_2, 206, 7, 0.031, -0.18, 1.7)):
            puntos = [(x, base + amp * math.sin(x * largo + t * vel + fase)
                       + 3 * math.sin(x * largo * 2.3 - t * vel * 0.7)) for x in range(0, W + 8, 8)]
            d.polygon(puntos + [(W, H), (0, H)], fill=color)
        # Barra superior
        if self.logo:
            img.paste(self.logo, (6, 1))
        else:
            d.text((8, 8), "Mini TV", font=self.f_barra, fill=GRIS_AZUL)
        # Sin internet el reloj no se sincroniza (la Pi no tiene pila): mejor "--:--" que una hora equivocada
        hora = time.strftime("%H:%M") if os.path.exists(RELOJ_SINCRONIZADO) else "--:--"
        d.text((W - 8 - d.textsize(hora, font=self.f_barra)[0], 8), hora, font=self.f_barra, fill=GRIS_AZUL)
        d.line((8, 29, W - 8, 29), fill=mezcla(FONDO, GRIS_AZUL, 0.18))
        self.fondo, self.t_fondo = img, t
        return img

    def dibujar(self, aviso=None):
        t = ahora()
        if self.anim:
            desde, hasta, t0 = self.anim
            k = min(1.0, (t - t0) / self.DURACION_ANIM)
            self.pos = desde + (hasta - desde) * suavizar(k)
            if k >= 1:
                self.anim = None
        img = self._fondo(t).copy()
        d = ImageDraw.Draw(img)

        if self.serie_abierta:
            self._cabecera_serie(d)
        elif self.consola_abierta:
            self._cabecera_consola(d)
        elif self.bt_pantalla:
            self._cabecera_bt(d)
        else:
            self._categorias(d)

        # Lista
        items = self.elementos()
        if items and self.foco >= len(items):          # la lista se acortó (p. ej. Bluetooth)
            self.foco, self.pos, self.anim = len(items) - 1, float(len(items) - 1), None
        items = self.elementos()
        # En la lista de juegos: lista a la izquierda (~55 %) y la portada del juego a la derecha
        con_portada = self.consola_abierta is not None
        gel = self.gel_estrecho if con_portada else self.gel
        ancho_max = gel.width - 24
        es_tv = (not self.serie_abierta and not self.consola_abierta and not self.bt_pantalla
                 and self.CATEGORIAS[self.cat] == "TV")
        if not items:
            texto = (self._vacio_bt() if self.bt_pantalla else
                     "Sin juegos todavía (usa enviar-juegos)" if self.en_juegos() else "Próximamente")
            tw, th = d.textsize(texto, font=self.f_item)
            d.text(((W - tw) // 2, 118), texto, font=self.f_item, fill=AZUL_GRIS)
        else:
            if self.foco >= 0:
                img.paste(gel, (16, self.Y_LISTA), gel)
            if con_portada and (self.juego_abierto or 0 <= self.foco < len(self.consola_abierta.juegos)):
                self._portada(img, d, self.consola_abierta,
                              self.juego_abierto or self.consola_abierta.juegos[self.foco])
            for i, (nombre, sub) in enumerate(items):
                dist = i - (self.pos if self.foco >= 0 else -1)
                if dist < -0.6:
                    continue
                if dist <= 1:
                    y = self.Y_LISTA + dist * (self.ALTO_GEL + 8)
                else:
                    y = self.Y_LISTA + self.ALTO_GEL + 8 + (dist - 1) * self.PASO
                if y > 196:
                    break
                if es_tv:
                    self._fila_canal(img, d, nombre, sub, int(y), dist, i == 0)
                elif self.foco >= 0 and abs(dist) < 0.5:
                    d.text((28, y + 6), recortar(d, nombre, self.f_sel, ancho_max), font=self.f_sel, fill=BLANCO)
                    d.text((29, y + 26), recortar(d, sub, self.f_sub, ancho_max), font=self.f_sub,
                           fill=mezcla(GEL, BLANCO, 0.8))
                else:
                    # texto simple que se va apagando hacia abajo
                    k = max(0.12, 0.85 - 0.22 * max(0.0, dist - 1)) if dist >= 0 else max(0.0, 1 + dist) * 0.6
                    d.text((28, y + 12), recortar(d, nombre, self.f_item, ancho_max), font=self.f_item,
                           fill=mezcla(FONDO, GRIS_AZUL, k))

        if aviso:
            tw, _ = d.textsize(aviso, font=self.f_aviso)
            d.text(((W - tw) // 2, H - 16), aviso, font=self.f_aviso, fill=GRIS_AZUL)
        if self.remoto_pantalla:
            self._panel_remoto(img, d)
        elif self.bt_pantalla:
            self._paneles_bt(d)
        elif self.tv.bt.visible() or (self.tv.bt.mensaje and ahora() < self.tv.bt.mensaje[1]):
            self._panel_visible(d)
        return img

    def _panel_visible(self, d):
        """Música → Conectar un teléfono: la TV visible como "Mini TV" (y el código si el teléfono lo pide)."""
        bt = self.tv.bt
        if bt.mensaje and ahora() < bt.mensaje[1]:
            lineas = [(bt.mensaje[0], self.f_sel, CELESTE)]
            if len(bt.mensaje) > 2 and bt.mensaje[2]:
                lineas.append((bt.mensaje[2], self.f_sub, GRIS_AZUL))
            self._panel(d, lineas)
        elif bt.codigo:
            self._panel(d, (("Confirma en el teléfono que el código es:", self.f_sub, GRIS_AZUL),
                            (" ".join(bt.codigo), self.f_codigo, BLANCO),
                            ("y toca «Vincular»", self.f_sub, CELESTE)), ancho=W - 40)
        else:
            resta = max(0, int(bt.visible_hasta - ahora()))
            self._panel(d, (("Visible como «Mini TV»", self.f_sel, CELESTE),
                            ("En tu teléfono: Ajustes → Bluetooth → Mini TV", self.f_sub, BLANCO),
