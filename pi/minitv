    def _portada(self, img, d, consola, juego):
        """Portada del juego seleccionado, centrada en el hueco de la derecha. Las prepara enviar-juegos
        en la Mac ya reducidas (máx. PORTADA_W x PORTADA_H): aquí solo se le ponen esquinas y borde."""
        x0, y0 = 16 + self.ANCHO_LISTA_JUEGOS + 8, self.Y_LISTA - 6       # hueco: hasta W-8 y y=202
        hueco_w, hueco_h = W - 8 - x0, 202 - y0
        ruta = os.path.join(consola.carpeta, "portadas", os.path.splitext(juego)[0] + ".png")
        try:
            fecha = os.path.getmtime(ruta)
        except OSError:
            fecha = None
        lista = self.portadas.get(ruta)
        if fecha is not None and (lista is None or lista[0] != fecha):
            try:
                foto = Image.open(ruta).convert("RGB")
                if foto.width > PORTADA_W or foto.height > PORTADA_H:     # por si llega una sin reducir
                    foto.thumbnail((PORTADA_W, PORTADA_H), Image.LANCZOS)
                marco = Image.new("RGBA", (foto.width + 2, foto.height + 2), (0, 0, 0, 0))
                rect_redondeado(ImageDraw.Draw(marco), (0, 0, marco.width - 1, marco.height - 1), 7,
                                CELESTE + (255,))                                    # borde celeste fino
                mascara = Image.new("L", foto.size, 0)
                rect_redondeado(ImageDraw.Draw(mascara), (0, 0, foto.width - 1, foto.height - 1), 6, 255)
                marco.paste(foto, (1, 1), mascara)
                lista = self.portadas[ruta] = (fecha, marco)
            except OSError:
                lista = None
        if fecha is not None and lista:
            marco = lista[1]
            img.paste(marco, (x0 + (hueco_w - marco.width) // 2, y0 + (hueco_h - marco.height) // 2), marco)
        else:   # sin portada: un hueco discreto con el nombre de la consola
            w, h = 96, 110
            x, y = x0 + (hueco_w - w) // 2, y0 + (hueco_h - h) // 2
            rect_redondeado(d, (x, y, x + w, y + h), 7, mezcla(FONDO, GRIS_AZUL, 0.08), mezcla(FONDO, CELESTE, 0.45))
            for texto, dy in ((consola.nombre, -8), ("sin portada", 8)):
                t = recortar(d, texto, self.f_sub, w - 10)
                tw, th = d.textsize(t, font=self.f_sub)
                d.text((x + (w - tw) // 2, y + h // 2 + dy - th // 2), t, font=self.f_sub,
                       fill=mezcla(FONDO, GRIS_AZUL, 0.6))

