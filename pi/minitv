    # ----- Ajustes → Bluetooth -----
    def abrir_bt(self):
        self.bt_pantalla, self.bt_mac = "inicio", None
        self.foco, self.pos, self.anim = 0, 0.0, None
        self.tv.bt.actualizar_guardados()

    def _ir_bt(self, pantalla, foco=0):
        self.bt_pantalla = pantalla
        self.foco, self.pos, self.anim = foco, float(foco), None

    def salir_bt(self):
        """Deja Bluetooth (cierra la sesión de bluetoothctl) y vuelve a Ajustes."""
        if self.bt_pantalla:
            self.tv.bt.cerrar_sesion()
        self.bt_pantalla = self.bt_mac = None
        self.cat = self.CATEGORIAS.index("Ajustes")
        self.foco, self.pos, self.anim = 1, 1.0, None

    def volver_bt(self):
        """Botón 1 dentro de Bluetooth: un nivel hacia atrás."""
        bt = self.tv.bt
        if bt.ocupado:
            return                                   # mientras empareja/conecta, esperar
        if self.bt_pantalla == "dispositivo":
            macs = [d["mac"] for d in bt.guardados]
            self._ir_bt("guardados", macs.index(self.bt_mac) if self.bt_mac in macs else 0)
        elif self.bt_pantalla in ("buscar", "guardados"):
            bt.dejar_de_buscar()
            self._ir_bt("inicio", 0 if self.bt_pantalla == "buscar" else 1)
        else:
            self.salir_bt()

    def _guardado(self):
        return next((d for d in self.tv.bt.guardados if d["mac"] == self.bt_mac), None)

    def _elementos_bt(self):
        bt = self.tv.bt
        if self.bt_pantalla == "inicio":
            n = len(bt.guardados)
            con = sum(1 for d in bt.guardados if d["conectado"])
            return [("Buscar dispositivos", "Teclados, mandos y parlantes cercanos"),
                    ("Dispositivos guardados", f"{n} guardado{'s' if n != 1 else ''} · {con} conectado{'s' if con != 1 else ''}")]
        if self.bt_pantalla == "buscar":
            return [(d["nombre"], f"{d['tipo'] or 'Consultando…'} · elegir para emparejar")
                    for d in bt.lista_encontrados()]
        if self.bt_pantalla == "guardados":
            return [(d["nombre"] or d["mac"], f"{d['tipo']} · {'Conectado' if d['conectado'] else 'No conectado'}")
                    for d in bt.guardados]
        d = self._guardado()
        if not d:
            return []
        return [("Desconectar" if d["conectado"] else "Conectar",
                 f"{d['tipo']} · ahora {'conectado' if d['conectado'] else 'no conectado'}"),
                ("Olvidar", "Quitarlo de la lista (habrá que volver a emparejarlo)")]

    def _elegir_bt(self):
        bt = self.tv.bt
        if bt.ocupado or bt.codigo:
            return None
        if self.bt_pantalla == "inicio":
            if self.foco == 0:
                self._ir_bt("buscar")
                bt.buscar()
            else:
                self._ir_bt("guardados")
                bt.actualizar_guardados()
        elif self.bt_pantalla == "buscar":
            lista = bt.lista_encontrados()
            if 0 <= self.foco < len(lista):
                bt.emparejar(lista[self.foco]["mac"], lista[self.foco]["nombre"])
        elif self.bt_pantalla == "guardados":
            if 0 <= self.foco < len(bt.guardados):
                self.bt_mac = bt.guardados[self.foco]["mac"]
                self._ir_bt("dispositivo")
        else:
            d = self._guardado()
            if d:
                nombre = d["nombre"] or d["mac"]
                if self.foco == 0:
                    bt.accion(d["mac"], nombre, "desconectar" if d["conectado"] else "conectar")
                else:
                    bt.accion(d["mac"], nombre, "olvidar")
                    self._ir_bt("guardados")
        return None

    def _vacio_bt(self):
        if self.bt_pantalla == "buscar":
            return "Buscando…" if self.tv.bt.buscando else "No se encontró nada"
        if self.bt_pantalla == "guardados":
            return "No hay dispositivos guardados"
        return "Próximamente"

