class Estatica:
    def __init__(self):
        self._quitar_rotulo()
        self.proc = subprocess.Popen([ESTATICA, "encendido"])
        self.visible = True
        self.con_rotulo = False

    def mostrar(self, rotulo=None):
        """rotulo: imagen RGBA 320x240 que minitv-estatica mezcla encima (p. ej. 'Cargando…')."""
        cambio = rotulo is not None or self.con_rotulo
        if rotulo is not None:
            tmp = ROTULO + ".tmp"
            with open(tmp, "wb") as f:
                f.write(rotulo.tobytes())
            os.replace(tmp, ROTULO)
            self.con_rotulo = True
        elif self.con_rotulo:
            self._quitar_rotulo()
            self.con_rotulo = False
        if (not self.visible or cambio) and self.proc.poll() is None:
            self.proc.send_signal(signal.SIGUSR2)      # al recibirla vuelve a leer el rótulo
        self.visible = True

    def ocultar(self):
        if self.visible and self.proc.poll() is None:
            self.proc.send_signal(signal.SIGUSR1)
        self.visible = False
        if self.con_rotulo:
            self._quitar_rotulo()
            self.con_rotulo = False

    @staticmethod
    def _quitar_rotulo():
        try:
            os.unlink(ROTULO)
        except OSError:
            pass

    def cerrar(self):
        if self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(2)
            except subprocess.TimeoutExpired:
                self.proc.kill()


class Framebuffer:
    def __init__(self):
        leer = lambda n: open(f"/sys/class/graphics/fb0/{n}").read().strip()
        self.bpp = int(leer("bits_per_pixel"))
        self.paso = int(leer("stride"))
        self.ancho, self.alto = (int(v) for v in leer("virtual_size").split(","))
        self.fd = os.open("/dev/fb0", os.O_RDWR)
        self.mem = mmap.mmap(self.fd, self.paso * self.alto)

    def mostrar(self, img):
        datos = img.tobytes("raw", "BGRX")          # fb0 es XRGB8888 (en memoria: B, G, R, X)
        fila = W * 4
        if self.paso == fila:
            self.mem[:len(datos)] = datos
        else:
            for y in range(H):
                self.mem[y * self.paso:y * self.paso + fila] = datos[y * fila:(y + 1) * fila]

    def negro(self):
        self.mem[:] = bytes(len(self.mem))


