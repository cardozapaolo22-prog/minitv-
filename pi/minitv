def orden_natural(texto):
    return [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", texto)]


def capitulo(archivo):
    """'Los Simpsons 4x20 - El día del Garrote.mp4' -> '4x20'."""
    m = re.search(r"(\d+)x(\d+)", archivo)
    if m:
        return f"{int(m.group(1))}x{int(m.group(2)):02d}"
    m = re.match(r"\s*(\d+)\s*([A-Za-z])?\s*-", archivo)     # '01 A - El rescate de Lula.avi' -> '01A'
    if m:
        return f"{int(m.group(1)):02d}{(m.group(2) or '').upper()}"
    return os.path.splitext(archivo)[0][:16]


def titulo_episodio(archivo):
    """'Los Simpsons 4x20 - El día del Garrote.mp4' -> 'El día del Garrote';
    '01 A - El rescate de Lula.mp4' -> 'El rescate de Lula'."""
    base = os.path.splitext(archivo)[0]
    m = re.search(r"\d+x\d+\s*-\s*(.+)$", base) or re.match(r"\s*\d+\s*[A-Za-z]?\s*-\s*(.+)$", base)
    return m.group(1).strip() if m else base


def mm_ss(segundos):
    return f"{int(segundos) // 60}:{int(segundos) % 60:02d}"


class Serie:
    def __init__(self, carpeta):
        self.carpeta = carpeta
        self.id = os.path.basename(carpeta)
        m = re.match(r"\s*(\d+)\s+(.+)", self.id)
        self.canal = int(m.group(1)) if m else 0
        self.nombre = m.group(2).strip() if m else self.id
        try:
            archivos = os.listdir(carpeta)
        except OSError:
            archivos = []
        self.episodios = sorted((f for f in archivos if f.lower().endswith(EXTENSIONES) and not f.startswith(".")),
                                key=orden_natural)

    @property
    def rotulo(self):
        return f"CH {self.canal:02d} · {self.nombre}"


def buscar_series():
    try:
        nombres = os.listdir(VIDEO_DIR)
    except OSError:
        return []
    series = [Serie(os.path.join(VIDEO_DIR, n)) for n in nombres
              if os.path.isdir(os.path.join(VIDEO_DIR, n)) and not n.startswith(".")
              and n != os.path.basename(LOGOS_DIR)]
    return sorted(series, key=lambda s: (s.canal, orden_natural(s.nombre)))


class Consola:
    """Una carpeta de ~/juegos (p. ej. 'snes') con sus juegos."""

    def __init__(self, id_, nombre, nucleo, extensiones):
        self.id, self.nombre, self.extensiones = id_, nombre, extensiones
        self.carpeta = os.path.join(JUEGOS_DIR, id_)
        self.nucleo = os.path.join(NUCLEOS_DIR, f"{nucleo}_libretro.so")
        try:
            archivos = [f for f in os.listdir(self.carpeta)
                        if f.lower().endswith(extensiones) and not f.startswith(".")]
        except OSError:
            archivos = []
        # PlayStation: los discos que ya nombra una lista .m3u (juegos de varios CD) no se repiten
        en_listas = set()
        for f in archivos:
            if f.lower().endswith(".m3u"):
                try:
                    with open(os.path.join(self.carpeta, f), errors="replace") as m3u:
                        en_listas.update(os.path.basename(l.strip()) for l in m3u if l.strip())
                except OSError:
                    pass
        self.juegos = sorted((f for f in archivos if f not in en_listas), key=orden_natural)
        # Títulos reales (arcade: "simpsons" -> "The Simpsons (4 Players World, set 1)"), los escribe enviar-juegos
        self.nombres = {}
        try:
            with open(os.path.join(self.carpeta, "nombres.txt"), errors="replace") as f:
                for linea in f:
                    if "\t" in linea:
                        corto, largo = linea.rstrip("\n").split("\t", 1)
                        self.nombres[corto] = largo
        except OSError:
            pass

    def estado_guardado(self, juego):
        """Ruta del estado automático de RetroArch (donde continuar), o None.
        Están en ~/juegos/estados/<emulador>/<juego sin extensión>.state.auto"""
        base = os.path.splitext(juego)[0] + ".state.auto"
        raiz = os.path.join(JUEGOS_DIR, "estados")
        try:
            carpetas = os.listdir(raiz)
        except OSError:
            return None
        for d in carpetas:
            ruta = os.path.join(raiz, d, base)
            if os.path.isfile(ruta):
                return ruta
        return None

    def fecha_guardado(self, juego):
        ruta = self.estado_guardado(juego)
        return time.strftime("%d/%m %H:%M", time.localtime(os.path.getmtime(ruta))) if ruta else None

    def titulo(self, juego):
        """Nombre para mostrar en el menú."""
        largo = self.nombres.get(os.path.splitext(juego)[0])
        if largo:
            return re.sub(r"\s*[\(\[][^\)\]]*[\)\]]", "", largo).strip() or largo
        return titulo_juego(juego)


def titulo_juego(archivo):
    """'Super Boss Gaiden (World) [!].sfc' -> 'Super Boss Gaiden'."""
    base = os.path.splitext(archivo)[0]
    limpio = re.sub(r"\s*[\(\[][^\)\]]*[\)\]]", "", base).strip()
    return limpio or base


def buscar_consolas():
    """Solo las consolas que tienen algún juego."""
    consolas = (Consola(*c) for c in CONSOLAS)
    return [c for c in consolas if c.juegos]


class Estado:
    """Última serie vista, volumen y, por serie, episodio y segundo donde se quedó.
    También el último juego de cada consola."""

    def __init__(self):
        self.datos = {"ultima": None, "volumen": 100, "series": {}, "juegos": {}}
        try:
            with open(ESTADO) as f:
                self.datos.update(json.load(f))
        except (OSError, ValueError):
            pass

    def guardar(self):
        os.makedirs(os.path.dirname(ESTADO), exist_ok=True)
        tmp = ESTADO + ".tmp"
        with open(tmp, "w") as f:
            json.dump(self.datos, f, ensure_ascii=False, indent=1)
        os.replace(tmp, ESTADO)

    def de(self, serie):
        return self.datos["series"].get(serie.id, {})

    def recordar(self, serie, episodio, segundo):
        self.datos["series"][serie.id] = {"episodio": episodio, "segundo": int(segundo)}
        self.datos["ultima"] = serie.id

    def seguir(self, serie):
        """(índice del episodio, segundo) donde continuar."""
        if not serie.episodios:
            return 0, 0
        d = self.de(serie)
        if d.get("episodio") in serie.episodios:
            return serie.episodios.index(d["episodio"]), max(0, int(d.get("segundo", 0)) - 3)
        return 0, 0


