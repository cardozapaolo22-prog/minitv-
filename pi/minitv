def rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


FONDO = rgb("0d1b3d")
GRIS_AZUL = rgb("c9d6f5")
CELESTE = rgb("7fd0ff")
AZUL_GRIS = rgb("8ea3d6")
GEL = rgb("2a6fd6")
GEL_BORDE = rgb("9fdcff")
BLANCO = (255, 255, 255)
ONDA_1 = rgb("142a5e")
ONDA_2 = rgb("1b3772")


def mezcla(a, b, k):
    """Color a mezclado hacia b en proporción k (0..1)."""
    return tuple(round(x + (y - x) * k) for x, y in zip(a, b))


def recortar(d, texto, fuente, ancho_max):
    """Recorta el texto con '…' para que quepa en ancho_max píxeles."""
    if d.textsize(texto, font=fuente)[0] <= ancho_max:
        return texto
    while texto and d.textsize(texto + "…", font=fuente)[0] > ancho_max:
        texto = texto[:-1]
    return texto.rstrip() + "…"


def suavizar(t):
    return 1 - (1 - t) ** 3     # ease-out


def rect_redondeado(d, caja, r, relleno, borde=None):
    """Rectángulo con esquinas redondeadas (Pillow 8.1 no trae rounded_rectangle)."""
    x0, y0, x1, y1 = caja
    d.rectangle((x0 + r, y0, x1 - r, y1), fill=relleno)
    d.rectangle((x0, y0 + r, x1, y1 - r), fill=relleno)
    for cx, cy, a in ((x0, y0, 180), (x1 - 2 * r, y0, 270), (x1 - 2 * r, y1 - 2 * r, 0), (x0, y1 - 2 * r, 90)):
        d.pieslice((cx, cy, cx + 2 * r, cy + 2 * r), a, a + 90, fill=relleno)
        if borde:
            d.arc((cx, cy, cx + 2 * r, cy + 2 * r), a, a + 90, fill=borde)
    if borde:
        d.line((x0 + r, y0, x1 - r, y0), fill=borde)
        d.line((x0 + r, y1, x1 - r, y1), fill=borde)
        d.line((x0, y0 + r, x0, y1 - r), fill=borde)
        d.line((x1, y0 + r, x1, y1 - r), fill=borde)


def boton_gel(ancho, alto, radio=10, s=3):
    """Botón 'gel': azul con degradado, brillo arriba, borde celeste y esquinas redondeadas.
    Se dibuja a s veces el tamaño y se reduce, para bordes suaves (Pillow 8.1 no tiene rounded_rectangle)."""
    A, B, R = ancho * s, alto * s, radio * s

    def mascara(margen, r):
        m = Image.new("L", (A, B), 0)
        d = ImageDraw.Draw(m)
        x0, y0, x1, y1 = margen, margen, A - 1 - margen, B - 1 - margen
        d.rectangle((x0 + r, y0, x1 - r, y1), fill=255)
        d.rectangle((x0, y0 + r, x1, y1 - r), fill=255)
        for cx, cy in ((x0, y0), (x1 - 2 * r, y0), (x0, y1 - 2 * r), (x1 - 2 * r, y1 - 2 * r)):
            d.ellipse((cx, cy, cx + 2 * r, cy + 2 * r), fill=255)
        return m

    img = Image.new("RGBA", (A, B), GEL_BORDE + (0,))
    img.putalpha(mascara(0, R))
    # Interior: degradado vertical (más claro arriba)
    degradado = Image.new("RGBA", (A, B))
    dg = ImageDraw.Draw(degradado)
    arriba, abajo = mezcla(GEL, BLANCO, 0.18), mezcla(GEL, (0, 0, 0), 0.22)
    for y in range(B):
        dg.line((0, y, A, y), fill=mezcla(arriba, abajo, y / B) + (255,))
    img.paste(degradado, (0, 0), mascara(int(1.4 * s), R - int(1.4 * s)))
    # Brillo: blanco translúcido arriba que se desvanece hacia la mitad del botón
    alto_brillo = int(B * 0.55)
    degradado_brillo = Image.new("L", (A, B), 0)
    db = ImageDraw.Draw(degradado_brillo)
    for y in range(alto_brillo):
        db.line((0, y, A, y), fill=int(90 * (1 - y / alto_brillo) ** 1.6))
    brillo = Image.new("RGBA", (A, B), (255, 255, 255, 0))
    brillo.putalpha(ImageChops.multiply(mascara(int(2.5 * s), R - int(2.5 * s)), degradado_brillo))
    img = Image.alpha_composite(img, brillo)
    return img.resize((ancho, alto), Image.LANCZOS)


class Menu:
    CATEGORIAS = ["TV", "Juegos", "Música", "Series", "USB", "Ajustes"]
    Y_LISTA = 74            # parte superior del botón seleccionado
