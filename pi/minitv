class Partida:
    """Un juego en pantalla. RetroArch guarda la batería y un estado automático al salir con QUIT."""

    ESPERA_IMAGEN = 0.35      # tras 'PLAYING', margen para que el primer cuadro llegue a la pantalla
    MAX_CARGA = 30.0          # si en este tiempo no dice 'PLAYING', se quita la estática igual

    def __init__(self, consola, juego, estado, estatica, nuevo=False):
        self.consola, self.juego, self.estado, self.estatica = consola, juego, estado, estatica
        extra = os.path.join(RUN, "retroarch-extra.cfg")
        vol = estado.datos.get("volumen", 100)
        with open(extra, "w") as f:
            if not AUDIO or vol <= 0:
                f.write('audio_mute_enable = "true"\n')
            else:   # el mismo límite que VLC (AUDIO_GAIN) por el volumen del menú, en dB
                f.write(f'audio_volume = "{20 * math.log10(AUDIO_GAIN * vol / 100):.1f}"\n')
            if consola.id in JUEGOS_AJUSTAR:     # p. ej. GBA 240x160 -> 320x213 (1,33x)
                f.write('video_scale_integer = "false"\n')
            if nuevo:                           # "Empezar de nuevo": no cargar el estado (al salir se guarda el nuevo)
                f.write('savestate_auto_load = "false"\n')
        for sub in ("partidas", "estados", "bios"):
            os.makedirs(os.path.join(JUEGOS_DIR, sub), exist_ok=True)
        args = [RETROARCH, "--verbose", "--config", RETROARCH_CFG, "--appendconfig", extra,
                "-L", consola.nucleo, os.path.join(consola.carpeta, juego)]
        self.registro = open(os.path.join(RUN, "retroarch.log"), "w")     # en /run (RAM): para diagnosticar
        self.proc = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=self.registro, stderr=subprocess.STDOUT)
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.sock.setblocking(False)
        self.t_inicio = ahora()
        self.t_consulta = 0
        self.t_jugando = None
        self.esperando_imagen = True
        estado.datos["juegos"][consola.id] = juego
        estado.datos["juegos"]["ultima_consola"] = consola.id
        estado.guardar()
        log(f"Jugar {consola.nombre}: {juego}")

    def vivo(self):
        return self.proc.poll() is None

    def orden(self, texto):
        try:
            self.sock.sendto(texto.encode(), ("127.0.0.1", RETROARCH_PUERTO))
        except OSError:
            pass

    def situacion(self):
        """'PLAYING', 'PAUSED', 'CONTENTLESS'... o None si RetroArch aún no responde."""
        try:
            while True:
                self.sock.recv(512)                 # descartar respuestas viejas
        except (BlockingIOError, OSError):
            pass
        self.orden("GET_STATUS")
        limite = ahora() + 0.05
        while ahora() < limite:
            try:
                r = self.sock.recv(512).decode("utf-8", "replace").split()
                return r[1] if len(r) > 1 and r[0] == "GET_STATUS" else None
            except BlockingIOError:
                time.sleep(0.005)
            except OSError:
                return None
        return None

    def tick(self):
        """Devuelve 'fin' si RetroArch terminó, si no None."""
        if not self.vivo():
            return "fin"
        if self.esperando_imagen:
            t = ahora()
            if self.t_jugando is None and t - self.t_consulta >= 0.15:
                self.t_consulta = t
                if self.situacion() == "PLAYING":
                    self.t_jugando = t
                    log(f"RetroArch jugando ({t - self.t_inicio:.1f} s)")
            listo = self.t_jugando is not None and t - self.t_jugando >= self.ESPERA_IMAGEN
            if listo or t - self.t_inicio > self.MAX_CARGA:
                self.estatica.ocultar()
                self.esperando_imagen = False
        return None

    def volumen(self, delta):
        v = max(0, min(100, self.estado.datos.get("volumen", 100) + delta))
        self.estado.datos["volumen"] = v
        self.orden("VOLUME_UP" if delta > 0 else "VOLUME_DOWN")
        log(f"Volumen {v}% (juego)")

    def parar(self):
        """QUIT: RetroArch guarda la partida y sale solo; si no, se le termina."""
        if self.vivo():
            self.orden("QUIT")
            try:
                self.proc.wait(5)
            except subprocess.TimeoutExpired:
                log("RetroArch no salió con QUIT: terminar")
                self.proc.terminate()
                try:
                    self.proc.wait(3)
                except subprocess.TimeoutExpired:
                    self.proc.kill()
        self.sock.close()
        self.registro.close()
        log(f"Fin del juego {self.juego} (código {self.proc.returncode})")


