def leer_conf(ruta):
    conf = {}
    try:
        with open(ruta) as f:
            for linea in f:
                linea = linea.strip()
                if linea and not linea.startswith("#") and "=" in linea:
                    clave, valor = linea.split("=", 1)
                    conf[clave.strip()] = valor.strip().strip('"').strip("'")
    except OSError:
        pass
    return conf


