#!/bin/bash
# minitv-alias: anuncia "minitv.local" (mDNS) con la IP actual de wlan0, en casa y en la red propia.
actual=""; pid=""
while true; do
    ip=$(/sbin/ip -4 -o addr show wlan0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
    if [ "$ip" != "$actual" ] || { [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; }; then
        [ -n "$pid" ] && kill "$pid" 2>/dev/null
        pid=""; actual="$ip"
        if [ -n "$ip" ]; then
            /usr/bin/avahi-publish -a -R minitv.local "$ip" >/dev/null 2>&1 &
            pid=$!
            echo "minitv-alias: minitv.local -> $ip"
        fi
    fi
    sleep 5
done
