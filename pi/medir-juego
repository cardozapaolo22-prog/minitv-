#!/bin/bash
# medir-juego [SEGUNDOS]: CPU de RetroArch (total y del hilo más cargado), temperatura y throttling.
SEG=${1:-20}
PID=$(pgrep -x retroarch | head -1)
[ -n "$PID" ] || { echo "RetroArch no está corriendo"; exit 1; }
N=$((SEG / 2))
top -b -H -d 2 -n $((N + 1)) -p "$PID" | awk -v n=$N "
  /^top -/ {m++; if (m>1) {tot[m]=t; hil[m]=h}; t=0; h=0; next}
  \$1 ~ /^[0-9]+$/ && NF>=12 {t+=\$9; if (\$9>h) h=\$9}
  END {tot[m+1]=t; hil[m+1]=h; st=0; sh=0; mh=0; k=0
       for (i=3;i<=m+1;i++){st+=tot[i]; sh+=hil[i]; if(hil[i]>mh) mh=hil[i]; k++}
       printf \"CPU RetroArch: %.0f%% total (de 400%%), hilo de emulación %.0f%% de media, %.0f%% máx.\n\", st/k, sh/k, mh}" &
TMIN=999; TMAX=0
for i in $(seq $N); do
  T=$(vcgencmd measure_temp | grep -oE "[0-9]+\.[0-9]"); T10=${T/./}
  [ $T10 -lt $TMIN ] && TMIN=$T10; [ $T10 -gt $TMAX ] && TMAX=$T10
  sleep 2
done
wait
echo "Temperatura: $((TMIN/10)).$((TMIN%10)) a $((TMAX/10)).$((TMAX%10)) °C   frecuencia: $(($(vcgencmd measure_clock arm | cut -d= -f2)/1000000)) MHz   throttled: $(vcgencmd get_throttled | cut -d= -f2)"
